    TSAltStockGroups: 0
    TSAltCostCentres: 0
    TSLogSales: "never"
    TSLogPurchases: "never"
    TSLogSalesOrders: "never"
    TSLogPurchaseOrders: "never"
    TSLogReceipts: "never"
    TSLogPayments: "never"
    TSLogCreditNotes: "never"
    TSLogDebitNotes: "never"
