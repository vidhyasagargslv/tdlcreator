[System: Variable]
    TSApiURL: "https://api.example.com/tally/{company}"
    TSApiKey: "YOUR_API_KEY"
    TSCompanyCode: "ACME"
    TSGateCompany: "ACME Pvt Ltd"
    TSGateGSTIN: "29ABCDE1234F1Z5"
    TSFromDate: $$MonthStart:##SVCurrentDate
    TSToDate: $$MonthEnd:##SVCurrentDate
    TSAltSales: 0
    TSAltPurchases: 0
    TSAltSalesOrders: 0
    TSAltPurchaseOrders: 0
    TSAltReceipts: 0
    TSAltPayments: 0
    TSAltCreditNotes: 0
