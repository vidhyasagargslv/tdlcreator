    TSLogGroups: "never"
    TSLogUnits: "never"
    TSLogGodowns: "never"
    TSLogStockGroups: "never"
    TSLogCostCentres: "never"
    TSLogStockSummary: "never"
    TSChunkFrom: ##SVFromDate
    TSChunkTo: ##SVToDate
    TSOneMID: 0
    TSQuiet: No

[System: Formula]
    TSBaseURL: "https://api.example.com/tally/" + ##TSCompanyCode
    TSAuthQS: ""
    TSGateOK: $$IsEqual:##SVCurrentCompany:##TSGateCompany AND $$IsEqual:($GSTRegistrationNumber:Company:##SVCurrentCompany):##TSGateGSTIN  ;; [EXPERIMENTAL] GSTIN method name

[Report: TS Config]
    Form: TS Config
    Title: "Sync Configuration"
    Variable: TSApiURL
    Variable: TSApiKey
    Variable: TSCompanyCode
    Variable: TSGateCompany
    Variable: TSGateGSTIN

[Form: TS Config]
    Part: TS Config
    Width: 70% Screen

[Part: TS Config]
    Lines: TS Config TSApiURL, TS Config TSApiKey, TS Config TSCompanyCode, TS Config TSGateCompany, TS Config TSGateGSTIN

[Line: TS Config TSApiURL]
    Fields: Medium Prompt, TS Config TSApiURL Fld
    Local: Field: Medium Prompt: Info: "API URL"

[Field: TS Config TSApiURL Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiURL
    Modifies: TSApiURL: Yes

[Line: TS Config TSApiKey]
    Fields: Medium Prompt, TS Config TSApiKey Fld
    Local: Field: Medium Prompt: Info: "API Key"

[Field: TS Config TSApiKey Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiKey
    Modifies: TSApiKey: Yes

[Line: TS Config TSCompanyCode]
    Fields: Medium Prompt, TS Config TSCompanyCode Fld
    Local: Field: Medium Prompt: Info: "Company Code"

[Field: TS Config TSCompanyCode Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSCompanyCode
    Modifies: TSCompanyCode: Yes

[Line: TS Config TSGateCompany]
    Fields: Medium Prompt, TS Config TSGateCompany Fld
    Local: Field: Medium Prompt: Info: "Allowed Company Name"

[Field: TS Config TSGateCompany Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSGateCompany
    Modifies: TSGateCompany: Yes

[Line: TS Config TSGateGSTIN]
    Fields: Medium Prompt, TS Config TSGateGSTIN Fld
    Local: Field: Medium Prompt: Info: "Allowed GSTIN"

[Field: TS Config TSGateGSTIN Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSGateGSTIN
    Modifies: TSGateGSTIN: Yes

[Report: TS Dates]
    Form: TS Dates
    Title: "Sync Date Range"
    Variable: TSFromDate
    Variable: TSToDate

[Form: TS Dates]
    Part: TS Dates
    Width: 70% Screen

[Part: TS Dates]
    Lines: TS Dates TSFromDate, TS Dates TSToDate

[Line: TS Dates TSFromDate]
    Fields: Medium Prompt, TS Dates TSFromDate Fld
    Local: Field: Medium Prompt: Info: "From Date"

[Field: TS Dates TSFromDate Fld]
    Use: Uni Date Field
    Set As: ##TSFromDate
    Modifies: TSFromDate: Yes

[Line: TS Dates TSToDate]
    Fields: Medium Prompt, TS Dates TSToDate Fld
    Local: Field: Medium Prompt: Info: "To Date"

[Field: TS Dates TSToDate Fld]
    Use: Uni Date Field
    Set As: ##TSToDate
    Modifies: TSToDate: Yes

;; [EXPERIMENTAL] sync-status UDFs (index numbers 21001-21002; change if they clash with other TDLs)
[System: UDF]
    TSSynced: Logical: 21001
    TSSyncedOn: Date: 21002

[Collection: TS Col Sales]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Sales, TS Flt Date, TS Flt Alt Sales, TS Flt Unsynced

[Report: TS Req Sales]
    Form: TS Req Sales
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req Sales]
    Part: TS Req Sales
    XMLTag: "ENVELOPE"

[Part: TS Req Sales]
    Line: TS Req Sales Hdr, TS Req Sales Row
    Repeat: TS Req Sales Row: TS Col Sales
    Scroll: Vertical

[Line: TS Req Sales Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req Sales Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F Narr, TS F GUID, TS F MasterID, TS F AlterID, TS F Synced
    Explode: TS LE Part: Yes
    Explode: TS IE Part: Yes

[Function: TS Push Sales]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: While: ##TSChunkFrom <= ##TSToDate
    06: Set: TSChunkTo: if $$MonthEnd:##TSChunkFrom > ##TSToDate then ##TSToDate else $$MonthEnd:##TSChunkFrom
    07: If: ##TSQuiet
    08: HTTP Post: @@TSBaseURL + "/sales" + @@TSAuthQS: ASCII: TS Req Sales
    09: Else
    10: HTTP Post: @@TSBaseURL + "/sales" + @@TSAuthQS: ASCII: TS Req Sales: TS Resp Err: TS Resp Ok
    11: End If
    12: Set: TSChunkFrom: ##TSChunkTo + 1
    13: End While
    14: Set: TSChunkFrom: ##TSFromDate
    15: Set: TSChunkTo: ##TSToDate
    16: Walk Collection: TS Col Sales
    17: Set: TSAltSales: if $AlterID > ##TSAltSales then $AlterID else ##TSAltSales
    18: Set Target
    19: Set Value: TSSynced: Yes
    20: Set Value: TSSyncedOn: $$MachineDate
    21: Save Target
    22: End Walk
    23: Set: TSLogSales: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col Sales) + " records sent"

