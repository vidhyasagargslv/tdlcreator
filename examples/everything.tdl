    14: Set: TSAltUnits: if $AlterID > ##TSAltUnits then $AlterID else ##TSAltUnits
    15: Set Target
    16: Set Value: TSSynced: Yes
    17: Set Value: TSSyncedOn: $$MachineDate
    18: Save Target
    19: End Walk
    20: Set: TSLogUnits: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col Units) + " records sent"

[Collection: TS Col Godowns]
    Type: Godown
    Fetch: *.*
    Filter: TS Flt Alt Godowns, TS Flt Unsynced

[Report: TS Req Godowns]
    Form: TS Req Godowns
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req Godowns]
    Part: TS Req Godowns
    XMLTag: "ENVELOPE"

[Part: TS Req Godowns]
    Line: TS Req Godowns Hdr, TS Req Godowns Row
    Repeat: TS Req Godowns Row: TS Col Godowns
    Scroll: Vertical

[Line: TS Req Godowns Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req Godowns Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID, TS F MasterID, TS F AlterID, TS F Synced

[Function: TS Push Godowns]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: If: ##TSQuiet
    07: HTTP Post: @@TSBaseURL + "/godowns" + @@TSAuthQS: ASCII: TS Req Godowns
    08: Else
    09: HTTP Post: @@TSBaseURL + "/godowns" + @@TSAuthQS: ASCII: TS Req Godowns: TS Resp Err: TS Resp Ok
    10: End If
    11: Set: TSChunkFrom: ##TSFromDate
    12: Set: TSChunkTo: ##TSToDate
    13: Walk Collection: TS Col Godowns
    14: Set: TSAltGodowns: if $AlterID > ##TSAltGodowns then $AlterID else ##TSAltGodowns
    15: Set Target
    16: Set Value: TSSynced: Yes
    17: Set Value: TSSyncedOn: $$MachineDate
    18: Save Target
    19: End Walk
    20: Set: TSLogGodowns: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col Godowns) + " records sent"

[Collection: TS Col StockGroups]
    Type: Stock Group
    Fetch: *.*
    Filter: TS Flt Alt StockGroups, TS Flt Unsynced

[Report: TS Req StockGroups]
    Form: TS Req StockGroups
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req StockGroups]
    Part: TS Req StockGroups
    XMLTag: "ENVELOPE"

[Part: TS Req StockGroups]
    Line: TS Req StockGroups Hdr, TS Req StockGroups Row
    Repeat: TS Req StockGroups Row: TS Col StockGroups
    Scroll: Vertical

[Line: TS Req StockGroups Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req StockGroups Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID, TS F MasterID, TS F AlterID, TS F Synced

[Function: TS Push StockGroups]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: If: ##TSQuiet
    07: HTTP Post: @@TSBaseURL + "/stockgroups" + @@TSAuthQS: ASCII: TS Req StockGroups
    08: Else
    09: HTTP Post: @@TSBaseURL + "/stockgroups" + @@TSAuthQS: ASCII: TS Req StockGroups: TS Resp Err: TS Resp Ok
    10: End If
    11: Set: TSChunkFrom: ##TSFromDate
    12: Set: TSChunkTo: ##TSToDate
    13: Walk Collection: TS Col StockGroups
    14: Set: TSAltStockGroups: if $AlterID > ##TSAltStockGroups then $AlterID else ##TSAltStockGroups
    15: Set Target
    16: Set Value: TSSynced: Yes
    17: Set Value: TSSyncedOn: $$MachineDate
    18: Save Target
    19: End Walk
    20: Set: TSLogStockGroups: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col StockGroups) + " records sent"

[Collection: TS Col CostCentres]
    Type: Cost Centre
    Fetch: *.*
    Filter: TS Flt Alt CostCentres, TS Flt Unsynced

[Report: TS Req CostCentres]
    Form: TS Req CostCentres
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req CostCentres]
    Part: TS Req CostCentres
    XMLTag: "ENVELOPE"

[Part: TS Req CostCentres]
    Line: TS Req CostCentres Hdr, TS Req CostCentres Row
    Repeat: TS Req CostCentres Row: TS Col CostCentres
    Scroll: Vertical

[Line: TS Req CostCentres Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req CostCentres Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID, TS F MasterID, TS F AlterID, TS F Synced

[Function: TS Push CostCentres]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: If: ##TSQuiet
    07: HTTP Post: @@TSBaseURL + "/costcentres" + @@TSAuthQS: ASCII: TS Req CostCentres
    08: Else
    09: HTTP Post: @@TSBaseURL + "/costcentres" + @@TSAuthQS: ASCII: TS Req CostCentres: TS Resp Err: TS Resp Ok
    10: End If
    11: Set: TSChunkFrom: ##TSFromDate
    12: Set: TSChunkTo: ##TSToDate
    13: Walk Collection: TS Col CostCentres
    14: Set: TSAltCostCentres: if $AlterID > ##TSAltCostCentres then $AlterID else ##TSAltCostCentres
    15: Set Target
    16: Set Value: TSSynced: Yes
    17: Set Value: TSSyncedOn: $$MachineDate
    18: Save Target
    19: End Walk
    20: Set: TSLogCostCentres: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col CostCentres) + " records sent"

[Collection: TS Col StockSummary]
    Type: Stock Item
    Fetch: Name, ClosingBalance, ClosingValue  ;; [EXPERIMENTAL] closing as of current period

[Report: TS Req StockSummary]
    Form: TS Req StockSummary
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req StockSummary]
    Part: TS Req StockSummary
    XMLTag: "ENVELOPE"

[Part: TS Req StockSummary]
    Line: TS Req StockSummary Hdr, TS Req StockSummary Row
    Repeat: TS Req StockSummary Row: TS Col StockSummary
    Scroll: Vertical

[Line: TS Req StockSummary Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req StockSummary Row]
    XMLTag: "STOCKITEM"
    Fields: TS SS Name, TS SS Qty, TS SS Value

[Function: TS Push StockSummary]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: HTTP Post: @@TSBaseURL + "/stocksummary" + @@TSAuthQS: ASCII: TS Req StockSummary: TS Resp Err: TS Resp Ok
    07: Set: TSLogStockSummary: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | sent"

[System: Formula]
    TS Flt Sales: $$IsVchTypeOf:$VoucherTypeName:"Sales"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Sales" if this errors
    TS Flt Alt Sales: $AlterID > ##TSAltSales
    TS Flt Purchases: $$IsVchTypeOf:$VoucherTypeName:"Purchase"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Purchase" if this errors
    TS Flt Alt Purchases: $AlterID > ##TSAltPurchases
    TS Flt SalesOrders: $$IsVchTypeOf:$VoucherTypeName:"Sales Order"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Sales Order" if this errors
    TS Flt Alt SalesOrders: $AlterID > ##TSAltSalesOrders
    TS Flt PurchaseOrders: $$IsVchTypeOf:$VoucherTypeName:"Purchase Order"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Purchase Order" if this errors
    TS Flt Alt PurchaseOrders: $AlterID > ##TSAltPurchaseOrders
    TS Flt Receipts: $$IsVchTypeOf:$VoucherTypeName:"Receipt"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Receipt" if this errors
    TS Flt Alt Receipts: $AlterID > ##TSAltReceipts
    TS Flt Payments: $$IsVchTypeOf:$VoucherTypeName:"Payment"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Payment" if this errors
    TS Flt Alt Payments: $AlterID > ##TSAltPayments
    TS Flt CreditNotes: $$IsVchTypeOf:$VoucherTypeName:"Credit Note"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Credit Note" if this errors
    TS Flt Alt CreditNotes: $AlterID > ##TSAltCreditNotes
    TS Flt DebitNotes: $$IsVchTypeOf:$VoucherTypeName:"Debit Note"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Debit Note" if this errors
    TS Flt Alt DebitNotes: $AlterID > ##TSAltDebitNotes
    TS Flt Journals: $$IsVchTypeOf:$VoucherTypeName:"Journal"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Journal" if this errors
    TS Flt Alt Journals: $AlterID > ##TSAltJournals
    TS Flt Contras: $$IsVchTypeOf:$VoucherTypeName:"Contra"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Contra" if this errors
    TS Flt Alt Contras: $AlterID > ##TSAltContras
    TS Flt StockJournals: $$IsVchTypeOf:$VoucherTypeName:"Stock Journal"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Stock Journal" if this errors
    TS Flt Alt StockJournals: $AlterID > ##TSAltStockJournals
    TS Flt DeliveryNotes: $$IsVchTypeOf:$VoucherTypeName:"Delivery Note"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Delivery Note" if this errors
    TS Flt Alt DeliveryNotes: $AlterID > ##TSAltDeliveryNotes
    TS Flt ReceiptNotes: $$IsVchTypeOf:$VoucherTypeName:"Receipt Note"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Receipt Note" if this errors
    TS Flt Alt ReceiptNotes: $AlterID > ##TSAltReceiptNotes
    TS Flt Alt Ledgers: $AlterID > ##TSAltLedgers
    TS Flt Alt StockItems: $AlterID > ##TSAltStockItems
    TS Flt Alt Groups: $AlterID > ##TSAltGroups
    TS Flt Alt Units: $AlterID > ##TSAltUnits
    TS Flt Alt Godowns: $AlterID > ##TSAltGodowns
    TS Flt Alt StockGroups: $AlterID > ##TSAltStockGroups
    TS Flt Alt CostCentres: $AlterID > ##TSAltCostCentres
    TS Flt Date: $Date >= ##TSChunkFrom AND $Date <= ##TSChunkTo
    TS Flt Unsynced: NOT $TSSynced
    TSAutoVch: $VoucherTypeName = "Sales" OR $VoucherTypeName = "Purchase"

;; [EXPERIMENTAL] full depth: ledger, inventory and bill-allocation sub-collections
[Part: TS LE Part]
    Line: TS LE Line
    Repeat: TS LE Line: AllLedgerEntries
    Scroll: Vertical

[Line: TS LE Line]
    XMLTag: "LEDGERENTRY"
    Fields: TS LE Ledger, TS LE Amount, TS LE GSTRate
    Explode: TS BA Part: Yes

[Part: TS BA Part]
    Line: TS BA Line
    Repeat: TS BA Line: BillAllocations
    Scroll: Vertical

[Line: TS BA Line]
    XMLTag: "BILLALLOCATION"
    Fields: TS BA Name, TS BA Type, TS BA Amount

[Part: TS IE Part]
    Line: TS IE Line
    Repeat: TS IE Line: AllInventoryEntries
    Scroll: Vertical

[Line: TS IE Line]
    XMLTag: "INVENTORYENTRY"
    Fields: TS IE Item, TS IE Qty, TS IE Rate, TS IE Amount

[Field: TS Hdr Company]
    Use: Name Field
    Set As: ##TSCompanyCode
    XMLTag: "COMPANY"

[Field: TS Hdr Cmp Name]
    Use: Name Field
    Set As: ##SVCurrentCompany
    XMLTag: "COMPANYNAME"

[Field: TS Hdr From]
    Use: Name Field
    Set As: $$String:##TSChunkFrom:UniversalDate
    XMLTag: "FROMDATE"

[Field: TS Hdr To]
    Use: Name Field
    Set As: $$String:##TSChunkTo:UniversalDate
    XMLTag: "TODATE"

[Field: TS F Date]
    Use: Name Field
    Set As: $$String:$Date:UniversalDate
    XMLTag: "DATE"

[Field: TS F VchNo]
    Use: Name Field
    Set As: $VoucherNumber
    XMLTag: "VOUCHERNUMBER"

[Field: TS F VchType]
    Use: Name Field
    Set As: $VoucherTypeName
    XMLTag: "VOUCHERTYPE"

[Field: TS F Party]
    Use: Name Field
    Set As: $PartyLedgerName
    XMLTag: "PARTYNAME"

[Field: TS F Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS F Narr]
    Use: Name Field
    Set As: $Narration
    XMLTag: "NARRATION"

[Field: TS F GUID]
    Use: Name Field
    Set As: $GUID
    XMLTag: "GUID"

[Field: TS F MasterID]
    Use: Name Field
    Set As: $$String:$MasterID
    XMLTag: "MASTERID"

[Field: TS F AlterID]
    Use: Name Field
    Set As: $$String:$AlterID
    XMLTag: "ALTERID"

[Field: TS F Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "NAME"

[Field: TS F Parent]
    Use: Name Field
    Set As: $Parent
    XMLTag: "PARENT"

[Field: TS LE Ledger]
    Use: Name Field
    Set As: $LedgerName
    XMLTag: "LEDGERNAME"

[Field: TS LE Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS LE GSTRate]
    Use: Name Field
    Set As: $$String:$GSTRate  ;; [EXPERIMENTAL] method name
    XMLTag: "GSTRATE"

[Field: TS IE Item]
    Use: Name Field
    Set As: $StockItemName
    XMLTag: "STOCKITEMNAME"

[Field: TS IE Qty]
    Use: Name Field
    Set As: $$String:$ActualQty
    XMLTag: "ACTUALQTY"

[Field: TS IE Rate]
    Use: Name Field
    Set As: $$String:$Rate
    XMLTag: "RATE"

[Field: TS IE Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS BA Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "BILLNAME"

[Field: TS BA Type]
    Use: Name Field
    Set As: $BillType
    XMLTag: "BILLTYPE"

[Field: TS BA Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS SS Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "NAME"

[Field: TS SS Qty]
    Use: Name Field
    Set As: $$String:$ClosingBalance
    XMLTag: "CLOSINGQTY"

[Field: TS SS Value]
    Use: Name Field
    Set As: $$String:$ClosingValue
    XMLTag: "CLOSINGVALUE"

[Field: TS F Synced]
    Use: Name Field
    Set As: $$String:$TSSynced
    XMLTag: "SYNCED"

[Report: TS Resp Ok]
    Form: TS Resp
    Title: "Sync Successful"

[Report: TS Resp Err]
    Form: TS Resp
    Title: "Sync Failed"

[Form: TS Resp]
    Part: TS Resp

[Part: TS Resp]
    Line: TS Resp
    Repeat: TS Resp: Parameter Collection
    Scroll: Vertical

[Line: TS Resp]
    Field: TS Resp

[Field: TS Resp]
    Use: Name Field
    Set As: $$String:$Name + " " + $$String:$Value  ;; [EXPERIMENTAL] Parameter Collection fields
    Full Width: Yes

[Function: TS Push All]
    00: Call: TS Push Sales
    01: Call: TS Push Purchases
    02: Call: TS Push SalesOrders
    03: Call: TS Push PurchaseOrders
    04: Call: TS Push Receipts
    05: Call: TS Push Payments
    06: Call: TS Push CreditNotes
    07: Call: TS Push DebitNotes
    08: Call: TS Push Journals
    09: Call: TS Push Contras
    10: Call: TS Push StockJournals
    11: Call: TS Push DeliveryNotes
    12: Call: TS Push ReceiptNotes
    13: Call: TS Push Ledgers
    14: Call: TS Push StockItems
    15: Call: TS Push Groups
    16: Call: TS Push Units
    17: Call: TS Push Godowns
    18: Call: TS Push StockGroups
    19: Call: TS Push CostCentres

[Function: TS Push All Quiet]
    00: Set: TSQuiet: Yes
    01: Call: TS Push All
    02: Set: TSQuiet: No

;; [EXPERIMENTAL] auto-push the saved voucher. Form Accept runs first so the voucher is saved, then the push.
[#Form: Voucher]
    Add: On: Form Accept: Yes: Form Accept
    Add: On: Form Accept: @@TSAutoVch AND @@TSGateOK: Call: TS Push One Vch

[Function: TS Push One Vch]
    00: Set: TSOneMID: $MasterID
    01: Set: TSChunkFrom: $Date
    02: Set: TSChunkTo: $Date
    03: HTTP Post: @@TSBaseURL + "/voucher" + @@TSAuthQS: ASCII: TS Req OneVch

[Collection: TS Col OneVch]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt OneVch

[System: Formula]
    TS Flt OneVch: $MasterID = ##TSOneMID

[Report: TS Req OneVch]
    Form: TS Req OneVch
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req OneVch]
    Part: TS Req OneVch
    XMLTag: "ENVELOPE"

[Part: TS Req OneVch]
    Line: TS Req OneVch Hdr, TS Req OneVch Row
    Repeat: TS Req OneVch Row: TS Col OneVch
    Scroll: Vertical

[Line: TS Req OneVch Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req OneVch Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F Narr, TS F GUID, TS F MasterID, TS F AlterID, TS F Synced
    Explode: TS LE Part: Yes
    Explode: TS IE Part: Yes

;; [EXPERIMENTAL] auto-push masters on save (form names Ledger / Stock Item assumed)
[#Form: Ledger]
    Add: On: Form Accept: Yes: Form Accept
    Add: On: Form Accept: @@TSGateOK: Call: TS Push One Ledger

[Function: TS Push One Ledger]
    00: Set: TSOneMID: $MasterID
    01: HTTP Post: @@TSBaseURL + "/ledger" + @@TSAuthQS: ASCII: TS Req OneLedger

[Collection: TS Col OneLedger]
    Type: Ledger
    Fetch: *.*
    Filter: TS Flt OneVch

[Report: TS Req OneLedger]
    Form: TS Req OneLedger
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req OneLedger]
    Part: TS Req OneLedger
    XMLTag: "ENVELOPE"

[Part: TS Req OneLedger]
    Line: TS Req OneLedger Hdr, TS Req OneLedger Row
    Repeat: TS Req OneLedger Row: TS Col OneLedger
    Scroll: Vertical

[Line: TS Req OneLedger Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req OneLedger Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID, TS F MasterID, TS F AlterID, TS F Synced

[#Form: Stock Item]
    Add: On: Form Accept: Yes: Form Accept
    Add: On: Form Accept: @@TSGateOK: Call: TS Push One StockItem

[Function: TS Push One StockItem]
    00: Set: TSOneMID: $MasterID
    01: HTTP Post: @@TSBaseURL + "/stockitem" + @@TSAuthQS: ASCII: TS Req OneStockItem

[Collection: TS Col OneStockItem]
    Type: Stock Item
    Fetch: *.*
    Filter: TS Flt OneVch

[Report: TS Req OneStockItem]
    Form: TS Req OneStockItem
    Export: Yes
    Export Header: "Content-Type: application/xml"
    Export Header: "x-api-key: " + ##TSApiKey

[Form: TS Req OneStockItem]
    Part: TS Req OneStockItem
    XMLTag: "ENVELOPE"

[Part: TS Req OneStockItem]
    Line: TS Req OneStockItem Hdr, TS Req OneStockItem Row
    Repeat: TS Req OneStockItem Row: TS Col OneStockItem
    Scroll: Vertical

[Line: TS Req OneStockItem Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req OneStockItem Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID, TS F MasterID, TS F AlterID, TS F Synced

;; Scheduled sync (System Timer event, syntax per TallyHelp)
[System: Event]
    TS Sync Timer: TIMER: @@TSGateOK: Call: TS Push All Quiet
    TS Sync Start: System Start: Yes: Start Timer: TS Sync Timer: 900

[Report: TS Log]
    Form: TS Log
    Title: "Sync Log"

[Form: TS Log]
    Part: TS Log
    Width: 80% Screen

[Part: TS Log]
    Lines: TS Log Sales, TS Log Purchases, TS Log SalesOrders, TS Log PurchaseOrders, TS Log Receipts, TS Log Payments, TS Log CreditNotes, TS Log DebitNotes, TS Log Journals, TS Log Contras, TS Log StockJournals, TS Log DeliveryNotes, TS Log ReceiptNotes, TS Log Ledgers, TS Log StockItems, TS Log Groups, TS Log Units, TS Log Godowns, TS Log StockGroups, TS Log CostCentres, TS Log StockSummary

[Line: TS Log Sales]
    Fields: Medium Prompt, TS Log Sales Fld
    Local: Field: Medium Prompt: Info: "Sales"

[Field: TS Log Sales Fld]
    Use: Name Field
    Set As: ##TSLogSales + " | unsynced: " + $$String:($$NumItems:TS Col Sales)
    Full Width: Yes

[Line: TS Log Purchases]
    Fields: Medium Prompt, TS Log Purchases Fld
    Local: Field: Medium Prompt: Info: "Purchases"

[Field: TS Log Purchases Fld]
    Use: Name Field
    Set As: ##TSLogPurchases + " | unsynced: " + $$String:($$NumItems:TS Col Purchases)
    Full Width: Yes

[Line: TS Log SalesOrders]
    Fields: Medium Prompt, TS Log SalesOrders Fld
    Local: Field: Medium Prompt: Info: "SalesOrders"

[Field: TS Log SalesOrders Fld]
    Use: Name Field
    Set As: ##TSLogSalesOrders + " | unsynced: " + $$String:($$NumItems:TS Col SalesOrders)
    Full Width: Yes

[Line: TS Log PurchaseOrders]
    Fields: Medium Prompt, TS Log PurchaseOrders Fld
    Local: Field: Medium Prompt: Info: "PurchaseOrders"

[Field: TS Log PurchaseOrders Fld]
    Use: Name Field
    Set As: ##TSLogPurchaseOrders + " | unsynced: " + $$String:($$NumItems:TS Col PurchaseOrders)
    Full Width: Yes

[Line: TS Log Receipts]
    Fields: Medium Prompt, TS Log Receipts Fld
    Local: Field: Medium Prompt: Info: "Receipts"

[Field: TS Log Receipts Fld]
    Use: Name Field
    Set As: ##TSLogReceipts + " | unsynced: " + $$String:($$NumItems:TS Col Receipts)
    Full Width: Yes

[Line: TS Log Payments]
    Fields: Medium Prompt, TS Log Payments Fld
    Local: Field: Medium Prompt: Info: "Payments"

[Field: TS Log Payments Fld]
    Use: Name Field
    Set As: ##TSLogPayments + " | unsynced: " + $$String:($$NumItems:TS Col Payments)
    Full Width: Yes

[Line: TS Log CreditNotes]
    Fields: Medium Prompt, TS Log CreditNotes Fld
    Local: Field: Medium Prompt: Info: "CreditNotes"

[Field: TS Log CreditNotes Fld]
    Use: Name Field
    Set As: ##TSLogCreditNotes + " | unsynced: " + $$String:($$NumItems:TS Col CreditNotes)
    Full Width: Yes

[Line: TS Log DebitNotes]
    Fields: Medium Prompt, TS Log DebitNotes Fld
    Local: Field: Medium Prompt: Info: "DebitNotes"

[Field: TS Log DebitNotes Fld]
    Use: Name Field
    Set As: ##TSLogDebitNotes + " | unsynced: " + $$String:($$NumItems:TS Col DebitNotes)
    Full Width: Yes

[Line: TS Log Journals]
    Fields: Medium Prompt, TS Log Journals Fld
    Local: Field: Medium Prompt: Info: "Journals"

[Field: TS Log Journals Fld]
    Use: Name Field
    Set As: ##TSLogJournals + " | unsynced: " + $$String:($$NumItems:TS Col Journals)
    Full Width: Yes

[Line: TS Log Contras]
    Fields: Medium Prompt, TS Log Contras Fld
    Local: Field: Medium Prompt: Info: "Contras"

[Field: TS Log Contras Fld]
    Use: Name Field
    Set As: ##TSLogContras + " | unsynced: " + $$String:($$NumItems:TS Col Contras)
    Full Width: Yes

