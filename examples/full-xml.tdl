;; ===== Generated by TDL Maker on 2026-10-27 =====
;; Menu: Sync | Config: Yes | Dates: Yes
;; Push: Sales, Purchases, SalesOrders, PurchaseOrders, Receipts, Payments, Ledgers, StockItems | Format: XML | Pull (experimental): Yes
;; URL template: https://api.example.com/tally/{company}?from={fromdate}&to={todate}
;; Load via F1 > TDL & Add-On > Manage Local TDLs.  UNTESTED on real TallyPrime - verify first.

[#Menu: Gateway of Tally]
    Add: Key Item: At End: Sync: Y: Menu: TS Sync Menu

[Menu: TS Sync Menu]
    Title: "Sync"
    Key Item: Configuration: C: Display: TS Config
    Key Item: Set Date Range: D: Display: TS Dates
    Key Item: Push Sales: 1: Call: TS Push Sales
    Key Item: Push Purchases: 2: Call: TS Push Purchases
    Key Item: Push SalesOrders: 3: Call: TS Push SalesOrders
    Key Item: Push PurchaseOrders: 4: Call: TS Push PurchaseOrders
    Key Item: Push Receipts: 5: Call: TS Push Receipts
    Key Item: Push Payments: 6: Call: TS Push Payments
    Key Item: Push Ledgers: 7: Call: TS Push Ledgers
    Key Item: Push StockItems: 8: Call: TS Push StockItems
    Key Item: Pull from URL (Experimental): P: Display: TS Pull Report
    Item: Blank
    Key Item: @@locQuit: Q: Menu Quit

[Variable: TSApiURL]
    Type: String
    Persistent: Yes

[Variable: TSApiKey]
    Type: String
    Persistent: Yes

[Variable: TSCompanyCode]
    Type: String
    Persistent: Yes

[Variable: TSFromDate]
    Type: Date
    Persistent: Yes

[Variable: TSToDate]
    Type: Date
    Persistent: Yes

[System: Variable]
    TSApiURL: "https://api.example.com/tally/{company}?from={fromdate}&to={todate}"
    TSApiKey: "YOUR_API_KEY"
    TSCompanyCode: "ACME"
    TSFromDate: $$MonthStart:##SVCurrentDate
    TSToDate: $$MonthEnd:##SVCurrentDate

[System: Formula]
    TSBaseURL: "https://api.example.com/tally/" + ##TSCompanyCode + "?from=" + $$String:##TSFromDate:UniversalDate + "&to=" + $$String:##TSToDate:UniversalDate

[Report: TS Config]
    Form: TS Config
    Title: "Sync Configuration"
    Variable: TSApiURL
    Variable: TSApiKey
    Variable: TSCompanyCode

[Form: TS Config]
    Part: TS Config
    Width: 70% Screen

[Part: TS Config]
    Lines: TS Config TSApiURL, TS Config TSApiKey, TS Config TSCompanyCode

[Line: TS Config TSApiURL]
    Fields: Medium Prompt, TS Config TSApiURL Fld
    Local: Field: Medium Prompt: Info: "API URL"

[Field: TS Config TSApiURL Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiURL
    Modifies: TSApiURL: Yes

[Line: TS Config TSApiKey]
    Fields: Medium Prompt, TS Config TSApiKey Fld
    Local: Field: Medium Prompt: Info: "API Key"

[Field: TS Config TSApiKey Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiKey
    Modifies: TSApiKey: Yes

[Line: TS Config TSCompanyCode]
    Fields: Medium Prompt, TS Config TSCompanyCode Fld
    Local: Field: Medium Prompt: Info: "Company Code"

[Field: TS Config TSCompanyCode Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSCompanyCode
    Modifies: TSCompanyCode: Yes

[Report: TS Dates]
    Form: TS Dates
    Title: "Sync Date Range"
    Variable: TSFromDate
    Variable: TSToDate

[Form: TS Dates]
    Part: TS Dates
    Width: 70% Screen

[Part: TS Dates]
    Lines: TS Dates TSFromDate, TS Dates TSToDate

[Line: TS Dates TSFromDate]
    Fields: Medium Prompt, TS Dates TSFromDate Fld
    Local: Field: Medium Prompt: Info: "From Date"

[Field: TS Dates TSFromDate Fld]
    Use: Uni Date Field
    Set As: ##TSFromDate
    Modifies: TSFromDate: Yes

[Line: TS Dates TSToDate]
    Fields: Medium Prompt, TS Dates TSToDate Fld
    Local: Field: Medium Prompt: Info: "To Date"

[Field: TS Dates TSToDate Fld]
    Use: Uni Date Field
    Set As: ##TSToDate
    Modifies: TSToDate: Yes

[Function: TS Push Sales]
    00: HTTP Post: @@TSBaseURL + "/sales": ASCII: TS Req Sales: TS Resp Err: TS Resp Ok

[Collection: TS Col Sales]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Sales, TS Flt Date

[System: Formula]
    TS Flt Sales: $$IsSysNameEqual:Sales:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Sales"

[Report: TS Req Sales]
    Form: TS Req Sales
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req Sales]
    Part: TS Req Sales
    XMLTag: "ENVELOPE"

[Part: TS Req Sales]
    Line: TS Req Sales Hdr, TS Req Sales Row
    Repeat: TS Req Sales Row: TS Col Sales
    Scroll: Vertical

[Line: TS Req Sales Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req Sales Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Function: TS Push Purchases]
    00: HTTP Post: @@TSBaseURL + "/purchases": ASCII: TS Req Purchases: TS Resp Err: TS Resp Ok

[Collection: TS Col Purchases]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Purchases, TS Flt Date

[System: Formula]
    TS Flt Purchases: $$IsSysNameEqual:Purchase:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Purchase"

[Report: TS Req Purchases]
    Form: TS Req Purchases
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req Purchases]
    Part: TS Req Purchases
    XMLTag: "ENVELOPE"

[Part: TS Req Purchases]
    Line: TS Req Purchases Hdr, TS Req Purchases Row
    Repeat: TS Req Purchases Row: TS Col Purchases
    Scroll: Vertical

[Line: TS Req Purchases Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req Purchases Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Function: TS Push SalesOrders]
    00: HTTP Post: @@TSBaseURL + "/salesorders": ASCII: TS Req SalesOrders: TS Resp Err: TS Resp Ok

[Collection: TS Col SalesOrders]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt SalesOrders, TS Flt Date

[System: Formula]
    TS Flt SalesOrders: $$IsSysNameEqual:SalesOrder:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Sales Order"

[Report: TS Req SalesOrders]
    Form: TS Req SalesOrders
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req SalesOrders]
    Part: TS Req SalesOrders
    XMLTag: "ENVELOPE"

[Part: TS Req SalesOrders]
    Line: TS Req SalesOrders Hdr, TS Req SalesOrders Row
    Repeat: TS Req SalesOrders Row: TS Col SalesOrders
    Scroll: Vertical

[Line: TS Req SalesOrders Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req SalesOrders Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Function: TS Push PurchaseOrders]
    00: HTTP Post: @@TSBaseURL + "/purchaseorders": ASCII: TS Req PurchaseOrders: TS Resp Err: TS Resp Ok

[Collection: TS Col PurchaseOrders]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt PurchaseOrders, TS Flt Date

[System: Formula]
    TS Flt PurchaseOrders: $$IsSysNameEqual:PurchaseOrder:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Purchase Order"

[Report: TS Req PurchaseOrders]
    Form: TS Req PurchaseOrders
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req PurchaseOrders]
    Part: TS Req PurchaseOrders
    XMLTag: "ENVELOPE"

[Part: TS Req PurchaseOrders]
    Line: TS Req PurchaseOrders Hdr, TS Req PurchaseOrders Row
    Repeat: TS Req PurchaseOrders Row: TS Col PurchaseOrders
    Scroll: Vertical

[Line: TS Req PurchaseOrders Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req PurchaseOrders Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Function: TS Push Receipts]
    00: HTTP Post: @@TSBaseURL + "/receipts": ASCII: TS Req Receipts: TS Resp Err: TS Resp Ok

[Collection: TS Col Receipts]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Receipts, TS Flt Date

[System: Formula]
    TS Flt Receipts: $$IsSysNameEqual:Receipt:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Receipt"

[Report: TS Req Receipts]
    Form: TS Req Receipts
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req Receipts]
    Part: TS Req Receipts
    XMLTag: "ENVELOPE"

[Part: TS Req Receipts]
    Line: TS Req Receipts Hdr, TS Req Receipts Row
    Repeat: TS Req Receipts Row: TS Col Receipts
    Scroll: Vertical

[Line: TS Req Receipts Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req Receipts Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Function: TS Push Payments]
    00: HTTP Post: @@TSBaseURL + "/payments": ASCII: TS Req Payments: TS Resp Err: TS Resp Ok

[Collection: TS Col Payments]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Payments, TS Flt Date

[System: Formula]
    TS Flt Payments: $$IsSysNameEqual:Payment:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Payment"

[Report: TS Req Payments]
    Form: TS Req Payments
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req Payments]
    Part: TS Req Payments
    XMLTag: "ENVELOPE"

[Part: TS Req Payments]
    Line: TS Req Payments Hdr, TS Req Payments Row
    Repeat: TS Req Payments Row: TS Col Payments
    Scroll: Vertical

[Line: TS Req Payments Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req Payments Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Function: TS Push Ledgers]
    00: HTTP Post: @@TSBaseURL + "/ledgers": ASCII: TS Req Ledgers: TS Resp Err: TS Resp Ok

[Collection: TS Col Ledgers]
    Type: Ledger
    Fetch: *.*

[Report: TS Req Ledgers]
    Form: TS Req Ledgers
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req Ledgers]
    Part: TS Req Ledgers
    XMLTag: "ENVELOPE"

[Part: TS Req Ledgers]
    Line: TS Req Ledgers Hdr, TS Req Ledgers Row
    Repeat: TS Req Ledgers Row: TS Col Ledgers
    Scroll: Vertical

[Line: TS Req Ledgers Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req Ledgers Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID

[Function: TS Push StockItems]
    00: HTTP Post: @@TSBaseURL + "/stockitems": ASCII: TS Req StockItems: TS Resp Err: TS Resp Ok

[Collection: TS Col StockItems]
    Type: Stock Item
    Fetch: *.*

[Report: TS Req StockItems]
    Form: TS Req StockItems
    Export: Yes
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:XML

[Form: TS Req StockItems]
    Part: TS Req StockItems
    XMLTag: "ENVELOPE"

[Part: TS Req StockItems]
    Line: TS Req StockItems Hdr, TS Req StockItems Row
    Repeat: TS Req StockItems Row: TS Col StockItems
    Scroll: Vertical

[Line: TS Req StockItems Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req StockItems Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID

[Field: TS Hdr Company]
    Use: Name Field
    Set As: ##TSCompanyCode
    XMLTag: "COMPANY"

[Field: TS Hdr Key]
    Use: Name Field
    Set As: ##TSApiKey
    XMLTag: "APIKEY"

[Field: TS Hdr From]
    Use: Name Field
    Set As: $$String:##TSFromDate:UniversalDate
    XMLTag: "FROMDATE"

[Field: TS Hdr To]
    Use: Name Field
    Set As: $$String:##TSToDate:UniversalDate
    XMLTag: "TODATE"

[Field: TS F Date]
    Use: Name Field
    Set As: $$String:$Date:UniversalDate
    XMLTag: "DATE"

[Field: TS F VchNo]
    Use: Name Field
    Set As: $VoucherNumber
    XMLTag: "VOUCHERNUMBER"

[Field: TS F VchType]
    Use: Name Field
    Set As: $VoucherTypeName
    XMLTag: "VOUCHERTYPE"

[Field: TS F Party]
    Use: Name Field
    Set As: $PartyLedgerName
    XMLTag: "PARTYNAME"

[Field: TS F Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS F GUID]
    Use: Name Field
    Set As: $GUID
    XMLTag: "GUID"

[Field: TS F Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "NAME"

[Field: TS F Parent]
    Use: Name Field
    Set As: $Parent
    XMLTag: "PARENT"

[System: Formula]
    TS Flt Date: $Date >= ##TSFromDate AND $Date <= ##TSToDate

[Report: TS Resp Ok]
    Form: TS Resp
    Title: "Sync Successful"

[Report: TS Resp Err]
    Form: TS Resp
    Title: "Sync Failed"

[Form: TS Resp]
    Part: TS Resp

[Part: TS Resp]
    Line: TS Resp

[Line: TS Resp]
    Field: TS Resp

[Field: TS Resp]
    Use: Name Field
    Set As: $$String:$RESPONSE
    Full Width: Yes

;; EXPERIMENTAL pull: reads remote XML <ENVELOPE><ROW><NAME/><VALUE/></ROW></ENVELOPE>
[Collection: TS Pull Col]
    RemoteURL: @@TSBaseURL + "/pull"
    XMLObjectPath: ROW: 1: ENVELOPE
    Fetch: NAME, VALUE

[Report: TS Pull Report]
    Form: TS Pull Report
    Title: "Remote Data (Experimental)"

[Form: TS Pull Report]
    Part: TS Pull Report

[Part: TS Pull Report]
    Line: TS Pull Line
    Repeat: TS Pull Line: TS Pull Col
    Scroll: Vertical

[Line: TS Pull Line]
    Fields: TS Pull Name, TS Pull Value

[Field: TS Pull Name]
    Use: Name Field
    Set As: $NAME

[Field: TS Pull Value]
    Use: Name Field
    Set As: $VALUE

