;; ===== Generated by TDL Maker v0.2 on 2026-10-27 =====
;; Vouchers: Sales, Receipts, CreditNotes
;; Masters: Ledgers | Stock summary: No
;; Format: JSON | Depth: header | Incremental: none | Chunk: none | Auth: query
;; Auto on voucher save: none | Auto on master save: No | Timer: 30 min
;; Gate: name | Sync-status UDF: No | Log: Yes | Pull (experimental): No
;; URL template: https://api.example.com/tally/{company}
;; Backend must reply <ENVELOPE><STATUS>1</STATUS></ENVELOPE> for HTTP Post to count as success.
;; Load via F1 > TDL & Add-On > Manage Local TDLs. UNTESTED on real TallyPrime - lines marked [EXPERIMENTAL] are least certain.

[#Menu: Gateway of Tally]
    Add: Key Item: At End: Sync: Y: Menu: TS Sync Menu

[Menu: TS Sync Menu]
    Title: "Sync"
    Key Item: Configuration: C: Display: TS Config
    Key Item: Set Date Range: D: Display: TS Dates
    Key Item: Push Sales Vouchers: 1: Call: TS Push Sales
    Key Item: Push Receipt Vouchers: 2: Call: TS Push Receipts
    Key Item: Push Credit Note Vouchers: 3: Call: TS Push CreditNotes
    Key Item: Push Ledgers: 4: Call: TS Push Ledgers
    Key Item: Push All: L: Call: TS Push All
    Key Item: Sync Log: Y: Display: TS Log
    Item: Blank
    Key Item: @@locQuit: Q: Menu Quit

[Variable: TSApiURL]
    Type: String
    Persistent: Yes

[Variable: TSApiKey]
    Type: String
    Persistent: Yes

[Variable: TSCompanyCode]
    Type: String
    Persistent: Yes

[Variable: TSGateCompany]
    Type: String
    Persistent: Yes

[Variable: TSGateGSTIN]
    Type: String
    Persistent: Yes

[Variable: TSFromDate]
    Type: Date
    Persistent: Yes

[Variable: TSToDate]
    Type: Date
    Persistent: Yes

[Variable: TSLogSales]
    Type: String
    Persistent: Yes

[Variable: TSLogReceipts]
    Type: String
    Persistent: Yes

[Variable: TSLogCreditNotes]
    Type: String
    Persistent: Yes

[Variable: TSLogLedgers]
    Type: String
    Persistent: Yes

[Variable: TSChunkFrom]
    Type: Date
    Persistent: No

[Variable: TSChunkTo]
    Type: Date
    Persistent: No

[Variable: TSOneMID]
    Type: Number
    Persistent: No

[Variable: TSQuiet]
    Type: Logical
    Persistent: No

[System: Variable]
    TSApiURL: "https://api.example.com/tally/{company}"
    TSApiKey: "YOUR_API_KEY"
    TSCompanyCode: "ACME"
    TSGateCompany: "ACME Pvt Ltd"
    TSGateGSTIN: ""
    TSFromDate: ##SVFromDate
    TSToDate: $$MonthEnd:##SVCurrentDate
    TSLogSales: "never"
    TSLogReceipts: "never"
    TSLogCreditNotes: "never"
    TSLogLedgers: "never"
    TSChunkFrom: ##SVFromDate
    TSChunkTo: ##SVToDate
    TSOneMID: 0
    TSQuiet: No

[System: Formula]
    TSBaseURL: "https://api.example.com/tally/" + ##TSCompanyCode
    TSAuthQS: "?apikey=" + ##TSApiKey
    TSGateOK: $$IsEqual:##SVCurrentCompany:##TSGateCompany

[Report: TS Config]
    Form: TS Config
    Title: "Sync Configuration"
    Variable: TSApiURL
    Variable: TSApiKey
    Variable: TSCompanyCode
    Variable: TSGateCompany
    Variable: TSGateGSTIN

[Form: TS Config]
    Part: TS Config
    Width: 70% Screen

[Part: TS Config]
    Lines: TS Config TSApiURL, TS Config TSApiKey, TS Config TSCompanyCode, TS Config TSGateCompany, TS Config TSGateGSTIN

[Line: TS Config TSApiURL]
    Fields: Medium Prompt, TS Config TSApiURL Fld
    Local: Field: Medium Prompt: Info: "API URL"

[Field: TS Config TSApiURL Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiURL
    Modifies: TSApiURL: Yes

[Line: TS Config TSApiKey]
    Fields: Medium Prompt, TS Config TSApiKey Fld
    Local: Field: Medium Prompt: Info: "API Key"

[Field: TS Config TSApiKey Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiKey
    Modifies: TSApiKey: Yes

[Line: TS Config TSCompanyCode]
    Fields: Medium Prompt, TS Config TSCompanyCode Fld
    Local: Field: Medium Prompt: Info: "Company Code"

[Field: TS Config TSCompanyCode Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSCompanyCode
    Modifies: TSCompanyCode: Yes

[Line: TS Config TSGateCompany]
    Fields: Medium Prompt, TS Config TSGateCompany Fld
    Local: Field: Medium Prompt: Info: "Allowed Company Name"

[Field: TS Config TSGateCompany Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSGateCompany
    Modifies: TSGateCompany: Yes

[Line: TS Config TSGateGSTIN]
    Fields: Medium Prompt, TS Config TSGateGSTIN Fld
    Local: Field: Medium Prompt: Info: "Allowed GSTIN"

[Field: TS Config TSGateGSTIN Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSGateGSTIN
    Modifies: TSGateGSTIN: Yes

[Report: TS Dates]
    Form: TS Dates
    Title: "Sync Date Range"
    Variable: TSFromDate
    Variable: TSToDate

[Form: TS Dates]
    Part: TS Dates
    Width: 70% Screen

[Part: TS Dates]
    Lines: TS Dates TSFromDate, TS Dates TSToDate

[Line: TS Dates TSFromDate]
    Fields: Medium Prompt, TS Dates TSFromDate Fld
    Local: Field: Medium Prompt: Info: "From Date"

[Field: TS Dates TSFromDate Fld]
    Use: Uni Date Field
    Set As: ##TSFromDate
    Modifies: TSFromDate: Yes

[Line: TS Dates TSToDate]
    Fields: Medium Prompt, TS Dates TSToDate Fld
    Local: Field: Medium Prompt: Info: "To Date"

[Field: TS Dates TSToDate Fld]
    Use: Uni Date Field
    Set As: ##TSToDate
    Modifies: TSToDate: Yes

[Collection: TS Col Sales]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Sales, TS Flt Date

[Report: TS Req Sales]
    Form: TS Req Sales
    Export: Yes
    JSONTag: "ENVELOPE"  ;; [EXPERIMENTAL] JSON export attribute
    Export Header: "Content-Type: application/json"

[Form: TS Req Sales]
    Part: TS Req Sales
    XMLTag: "ENVELOPE"

[Part: TS Req Sales]
    Line: TS Req Sales Hdr, TS Req Sales Row
    Repeat: TS Req Sales Row: TS Col Sales
    Scroll: Vertical

[Line: TS Req Sales Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req Sales Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F Narr, TS F GUID, TS F MasterID, TS F AlterID

[Function: TS Push Sales]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: If: ##TSQuiet
    07: HTTP Post: @@TSBaseURL + "/sales" + @@TSAuthQS: UTF8: TS Req Sales
    08: Else
    09: HTTP Post: @@TSBaseURL + "/sales" + @@TSAuthQS: UTF8: TS Req Sales: TS Resp Err: TS Resp Ok
    10: End If

    11: Set: TSLogSales: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col Sales) + " records sent"

[Collection: TS Col Receipts]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Receipts, TS Flt Date

[Report: TS Req Receipts]
    Form: TS Req Receipts
    Export: Yes
    JSONTag: "ENVELOPE"  ;; [EXPERIMENTAL] JSON export attribute
    Export Header: "Content-Type: application/json"

[Form: TS Req Receipts]
    Part: TS Req Receipts
    XMLTag: "ENVELOPE"

[Part: TS Req Receipts]
    Line: TS Req Receipts Hdr, TS Req Receipts Row
    Repeat: TS Req Receipts Row: TS Col Receipts
    Scroll: Vertical

[Line: TS Req Receipts Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req Receipts Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F Narr, TS F GUID, TS F MasterID, TS F AlterID

[Function: TS Push Receipts]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: If: ##TSQuiet
    07: HTTP Post: @@TSBaseURL + "/receipts" + @@TSAuthQS: UTF8: TS Req Receipts
    08: Else
    09: HTTP Post: @@TSBaseURL + "/receipts" + @@TSAuthQS: UTF8: TS Req Receipts: TS Resp Err: TS Resp Ok
    10: End If

    11: Set: TSLogReceipts: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col Receipts) + " records sent"

[Collection: TS Col CreditNotes]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt CreditNotes, TS Flt Date

[Report: TS Req CreditNotes]
    Form: TS Req CreditNotes
    Export: Yes
    JSONTag: "ENVELOPE"  ;; [EXPERIMENTAL] JSON export attribute
    Export Header: "Content-Type: application/json"

[Form: TS Req CreditNotes]
    Part: TS Req CreditNotes
    XMLTag: "ENVELOPE"

[Part: TS Req CreditNotes]
    Line: TS Req CreditNotes Hdr, TS Req CreditNotes Row
    Repeat: TS Req CreditNotes Row: TS Col CreditNotes
    Scroll: Vertical

[Line: TS Req CreditNotes Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req CreditNotes Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F Narr, TS F GUID, TS F MasterID, TS F AlterID

[Function: TS Push CreditNotes]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: If: ##TSQuiet
    07: HTTP Post: @@TSBaseURL + "/creditnotes" + @@TSAuthQS: UTF8: TS Req CreditNotes
    08: Else
    09: HTTP Post: @@TSBaseURL + "/creditnotes" + @@TSAuthQS: UTF8: TS Req CreditNotes: TS Resp Err: TS Resp Ok
    10: End If

    11: Set: TSLogCreditNotes: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col CreditNotes) + " records sent"

[Collection: TS Col Ledgers]
    Type: Ledger
    Fetch: *.*

[Report: TS Req Ledgers]
    Form: TS Req Ledgers
    Export: Yes
    JSONTag: "ENVELOPE"  ;; [EXPERIMENTAL] JSON export attribute
    Export Header: "Content-Type: application/json"

[Form: TS Req Ledgers]
    Part: TS Req Ledgers
    XMLTag: "ENVELOPE"

[Part: TS Req Ledgers]
    Line: TS Req Ledgers Hdr, TS Req Ledgers Row
    Repeat: TS Req Ledgers Row: TS Col Ledgers
    Scroll: Vertical

[Line: TS Req Ledgers Hdr]
    Fields: TS Hdr Company, TS Hdr Cmp Name, TS Hdr From, TS Hdr To

[Line: TS Req Ledgers Row]
    XMLTag: "MASTER"
    Fields: TS F Name, TS F Parent, TS F GUID, TS F MasterID, TS F AlterID

[Function: TS Push Ledgers]
    00: If: NOT @@TSGateOK
    01: Msg Box: "Sync blocked": "Open company does not match the configured company"
    02: Return
    03: End If
    04: Set: TSChunkFrom: ##TSFromDate
    05: Set: TSChunkTo: ##TSToDate
    06: If: ##TSQuiet
    07: HTTP Post: @@TSBaseURL + "/ledgers" + @@TSAuthQS: UTF8: TS Req Ledgers
    08: Else
    09: HTTP Post: @@TSBaseURL + "/ledgers" + @@TSAuthQS: UTF8: TS Req Ledgers: TS Resp Err: TS Resp Ok
    10: End If

    11: Set: TSLogLedgers: $$String:$$MachineDate + " " + $$String:$$MachineTime + " | " + $$String:($$NumItems:TS Col Ledgers) + " records sent"

[System: Formula]
    TS Flt Sales: $$IsVchTypeOf:$VoucherTypeName:"Sales"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Sales" if this errors
    TS Flt Receipts: $$IsVchTypeOf:$VoucherTypeName:"Receipt"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Receipt" if this errors
    TS Flt CreditNotes: $$IsVchTypeOf:$VoucherTypeName:"Credit Note"  ;; [EXPERIMENTAL] use $VoucherTypeName = "Credit Note" if this errors
    TS Flt Date: $Date >= ##TSChunkFrom AND $Date <= ##TSChunkTo
    TSAutoVch: No

[Field: TS Hdr Company]
    Use: Name Field
    Set As: ##TSCompanyCode
    XMLTag: "COMPANY"

[Field: TS Hdr Cmp Name]
    Use: Name Field
    Set As: ##SVCurrentCompany
    XMLTag: "COMPANYNAME"

[Field: TS Hdr From]
    Use: Name Field
    Set As: $$String:##TSChunkFrom:UniversalDate
    XMLTag: "FROMDATE"

[Field: TS Hdr To]
    Use: Name Field
    Set As: $$String:##TSChunkTo:UniversalDate
    XMLTag: "TODATE"

[Field: TS F Date]
    Use: Name Field
    Set As: $$String:$Date:UniversalDate
    XMLTag: "DATE"

[Field: TS F VchNo]
    Use: Name Field
    Set As: $VoucherNumber
    XMLTag: "VOUCHERNUMBER"

[Field: TS F VchType]
    Use: Name Field
    Set As: $VoucherTypeName
    XMLTag: "VOUCHERTYPE"

[Field: TS F Party]
    Use: Name Field
    Set As: $PartyLedgerName
    XMLTag: "PARTYNAME"

[Field: TS F Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS F Narr]
    Use: Name Field
    Set As: $Narration
    XMLTag: "NARRATION"

[Field: TS F GUID]
    Use: Name Field
    Set As: $GUID
    XMLTag: "GUID"

[Field: TS F MasterID]
    Use: Name Field
    Set As: $$String:$MasterID
    XMLTag: "MASTERID"

[Field: TS F AlterID]
    Use: Name Field
    Set As: $$String:$AlterID
    XMLTag: "ALTERID"

[Field: TS F Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "NAME"

[Field: TS F Parent]
    Use: Name Field
    Set As: $Parent
    XMLTag: "PARENT"

[Field: TS LE Ledger]
    Use: Name Field
    Set As: $LedgerName
    XMLTag: "LEDGERNAME"

[Field: TS LE Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS LE GSTRate]
    Use: Name Field
    Set As: $$String:$GSTRate  ;; [EXPERIMENTAL] method name
    XMLTag: "GSTRATE"

[Field: TS IE Item]
    Use: Name Field
    Set As: $StockItemName
    XMLTag: "STOCKITEMNAME"

[Field: TS IE Qty]
    Use: Name Field
    Set As: $$String:$ActualQty
    XMLTag: "ACTUALQTY"

[Field: TS IE Rate]
    Use: Name Field
    Set As: $$String:$Rate
    XMLTag: "RATE"

[Field: TS IE Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS BA Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "BILLNAME"

[Field: TS BA Type]
    Use: Name Field
    Set As: $BillType
    XMLTag: "BILLTYPE"

[Field: TS BA Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS SS Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "NAME"

[Field: TS SS Qty]
    Use: Name Field
    Set As: $$String:$ClosingBalance
    XMLTag: "CLOSINGQTY"

[Field: TS SS Value]
    Use: Name Field
    Set As: $$String:$ClosingValue
    XMLTag: "CLOSINGVALUE"

[Report: TS Resp Ok]
    Form: TS Resp
    Title: "Sync Successful"

[Report: TS Resp Err]
    Form: TS Resp
    Title: "Sync Failed"

[Form: TS Resp]
    Part: TS Resp

[Part: TS Resp]
    Line: TS Resp
    Repeat: TS Resp: Parameter Collection
    Scroll: Vertical

[Line: TS Resp]
    Field: TS Resp

[Field: TS Resp]
    Use: Name Field
    Set As: $$String:$Name + " " + $$String:$Value  ;; [EXPERIMENTAL] Parameter Collection fields
    Full Width: Yes

[Function: TS Push All]
    00: Call: TS Push Sales
    01: Call: TS Push Receipts
    02: Call: TS Push CreditNotes
    03: Call: TS Push Ledgers

[Function: TS Push All Quiet]
    00: Set: TSQuiet: Yes
    01: Call: TS Push All
    02: Set: TSQuiet: No

;; Scheduled sync (System Timer event, syntax per TallyHelp)
[System: Event]
    TS Sync Timer: TIMER: @@TSGateOK: Call: TS Push All Quiet
    TS Sync Start: System Start: Yes: Start Timer: TS Sync Timer: 1800

[Report: TS Log]
    Form: TS Log
    Title: "Sync Log"

[Form: TS Log]
    Part: TS Log
    Width: 80% Screen

[Part: TS Log]
    Lines: TS Log Sales, TS Log Receipts, TS Log CreditNotes, TS Log Ledgers

[Line: TS Log Sales]
    Fields: Medium Prompt, TS Log Sales Fld
    Local: Field: Medium Prompt: Info: "Sales"

[Field: TS Log Sales Fld]
    Use: Name Field
    Set As: ##TSLogSales
    Full Width: Yes

[Line: TS Log Receipts]
    Fields: Medium Prompt, TS Log Receipts Fld
    Local: Field: Medium Prompt: Info: "Receipts"

[Field: TS Log Receipts Fld]
    Use: Name Field
    Set As: ##TSLogReceipts
    Full Width: Yes

[Line: TS Log CreditNotes]
    Fields: Medium Prompt, TS Log CreditNotes Fld
    Local: Field: Medium Prompt: Info: "CreditNotes"

[Field: TS Log CreditNotes Fld]
    Use: Name Field
    Set As: ##TSLogCreditNotes
    Full Width: Yes

[Line: TS Log Ledgers]
    Fields: Medium Prompt, TS Log Ledgers Fld
    Local: Field: Medium Prompt: Info: "Ledgers"

[Field: TS Log Ledgers Fld]
    Use: Name Field
    Set As: ##TSLogLedgers
    Full Width: Yes

[#Menu: TS Sync Menu]
    Add: Key Item: Retry / Re-run All: R: Call: TS Push All

