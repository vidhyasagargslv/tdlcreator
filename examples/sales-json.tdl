;; ===== Generated by TDL Maker on 2026-10-27 =====
;; Menu: Sales Sync | Config: Yes | Dates: Yes
;; Push: Sales, Receipts | Format: JSON | Pull (experimental): No
;; URL template: https://api.example.com/{company}
;; Load via F1 > TDL & Add-On > Manage Local TDLs.  UNTESTED on real TallyPrime - verify first.

[#Menu: Gateway of Tally]
    Add: Key Item: At End: Sales Sync: Y: Menu: TS Sync Menu

[Menu: TS Sync Menu]
    Title: "Sales Sync"
    Key Item: Configuration: C: Display: TS Config
    Key Item: Set Date Range: D: Display: TS Dates
    Key Item: Push Sales: 1: Call: TS Push Sales
    Key Item: Push Receipts: 2: Call: TS Push Receipts
    Item: Blank
    Key Item: @@locQuit: Q: Menu Quit

[Variable: TSApiURL]
    Type: String
    Persistent: Yes

[Variable: TSApiKey]
    Type: String
    Persistent: Yes

[Variable: TSCompanyCode]
    Type: String
    Persistent: Yes

[Variable: TSFromDate]
    Type: Date
    Persistent: Yes

[Variable: TSToDate]
    Type: Date
    Persistent: Yes

[System: Variable]
    TSApiURL: "https://api.example.com/{company}"
    TSApiKey: "KEY"
    TSCompanyCode: "C1"
    TSFromDate: $$YearStart:##SVCurrentDate
    TSToDate: $$MonthEnd:##SVCurrentDate

[System: Formula]
    TSBaseURL: "https://api.example.com/" + ##TSCompanyCode

[Report: TS Config]
    Form: TS Config
    Title: "Sync Configuration"
    Variable: TSApiURL
    Variable: TSApiKey
    Variable: TSCompanyCode

[Form: TS Config]
    Part: TS Config
    Width: 70% Screen

[Part: TS Config]
    Lines: TS Config TSApiURL, TS Config TSApiKey, TS Config TSCompanyCode

[Line: TS Config TSApiURL]
    Fields: Medium Prompt, TS Config TSApiURL Fld
    Local: Field: Medium Prompt: Info: "API URL"

[Field: TS Config TSApiURL Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiURL
    Modifies: TSApiURL: Yes

[Line: TS Config TSApiKey]
    Fields: Medium Prompt, TS Config TSApiKey Fld
    Local: Field: Medium Prompt: Info: "API Key"

[Field: TS Config TSApiKey Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiKey
    Modifies: TSApiKey: Yes

[Line: TS Config TSCompanyCode]
    Fields: Medium Prompt, TS Config TSCompanyCode Fld
    Local: Field: Medium Prompt: Info: "Company Code"

[Field: TS Config TSCompanyCode Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSCompanyCode
    Modifies: TSCompanyCode: Yes

[Report: TS Dates]
    Form: TS Dates
    Title: "Sync Date Range"
    Variable: TSFromDate
    Variable: TSToDate

[Form: TS Dates]
    Part: TS Dates
    Width: 70% Screen

[Part: TS Dates]
    Lines: TS Dates TSFromDate, TS Dates TSToDate

[Line: TS Dates TSFromDate]
    Fields: Medium Prompt, TS Dates TSFromDate Fld
    Local: Field: Medium Prompt: Info: "From Date"

[Field: TS Dates TSFromDate Fld]
    Use: Uni Date Field
    Set As: ##TSFromDate
    Modifies: TSFromDate: Yes

[Line: TS Dates TSToDate]
    Fields: Medium Prompt, TS Dates TSToDate Fld
    Local: Field: Medium Prompt: Info: "To Date"

[Field: TS Dates TSToDate Fld]
    Use: Uni Date Field
    Set As: ##TSToDate
    Modifies: TSToDate: Yes

[Function: TS Push Sales]
    00: HTTP Post: @@TSBaseURL + "/sales": UTF8: TS Req Sales: TS Resp Err: TS Resp Ok

[Collection: TS Col Sales]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Sales, TS Flt Date

[System: Formula]
    TS Flt Sales: $$IsSysNameEqual:Sales:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Sales"

[Report: TS Req Sales]
    Form: TS Req Sales
    Export: Yes
    JSONTag: "sales"
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:JSONEx

[Form: TS Req Sales]
    Part: TS Req Sales
    XMLTag: "ENVELOPE"

[Part: TS Req Sales]
    Line: TS Req Sales Hdr, TS Req Sales Row
    Repeat: TS Req Sales Row: TS Col Sales
    Scroll: Vertical

[Line: TS Req Sales Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req Sales Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Function: TS Push Receipts]
    00: HTTP Post: @@TSBaseURL + "/receipts": UTF8: TS Req Receipts: TS Resp Err: TS Resp Ok

[Collection: TS Col Receipts]
    Type: Voucher
    Fetch: *.*
    Filter: TS Flt Receipts, TS Flt Date

[System: Formula]
    TS Flt Receipts: $$IsSysNameEqual:Receipt:$VoucherTypeName OR $$IsVchTypeOf:$VoucherTypeName:"Receipt"

[Report: TS Req Receipts]
    Form: TS Req Receipts
    Export: Yes
    JSONTag: "receipts"
    Variable: SVExportFormat
    Set: SVExportFormat: $$SysName:JSONEx

[Form: TS Req Receipts]
    Part: TS Req Receipts
    XMLTag: "ENVELOPE"

[Part: TS Req Receipts]
    Line: TS Req Receipts Hdr, TS Req Receipts Row
    Repeat: TS Req Receipts Row: TS Col Receipts
    Scroll: Vertical

[Line: TS Req Receipts Hdr]
    Fields: TS Hdr Company, TS Hdr Key, TS Hdr From, TS Hdr To

[Line: TS Req Receipts Row]
    XMLTag: "VOUCHER"
    Fields: TS F Date, TS F VchNo, TS F VchType, TS F Party, TS F Amount, TS F GUID

[Field: TS Hdr Company]
    Use: Name Field
    Set As: ##TSCompanyCode
    XMLTag: "COMPANY"

[Field: TS Hdr Key]
    Use: Name Field
    Set As: ##TSApiKey
    XMLTag: "APIKEY"

[Field: TS Hdr From]
    Use: Name Field
    Set As: $$String:##TSFromDate:UniversalDate
    XMLTag: "FROMDATE"

[Field: TS Hdr To]
    Use: Name Field
    Set As: $$String:##TSToDate:UniversalDate
    XMLTag: "TODATE"

[Field: TS F Date]
    Use: Name Field
    Set As: $$String:$Date:UniversalDate
    XMLTag: "DATE"

[Field: TS F VchNo]
    Use: Name Field
    Set As: $VoucherNumber
    XMLTag: "VOUCHERNUMBER"

[Field: TS F VchType]
    Use: Name Field
    Set As: $VoucherTypeName
    XMLTag: "VOUCHERTYPE"

[Field: TS F Party]
    Use: Name Field
    Set As: $PartyLedgerName
    XMLTag: "PARTYNAME"

[Field: TS F Amount]
    Use: Name Field
    Set As: $$String:$Amount
    XMLTag: "AMOUNT"

[Field: TS F GUID]
    Use: Name Field
    Set As: $GUID
    XMLTag: "GUID"

[Field: TS F Name]
    Use: Name Field
    Set As: $Name
    XMLTag: "NAME"

[Field: TS F Parent]
    Use: Name Field
    Set As: $Parent
    XMLTag: "PARENT"

[System: Formula]
    TS Flt Date: $Date >= ##TSFromDate AND $Date <= ##TSToDate

[Report: TS Resp Ok]
    Form: TS Resp
    Title: "Sync Successful"

[Report: TS Resp Err]
    Form: TS Resp
    Title: "Sync Failed"

[Form: TS Resp]
    Part: TS Resp

[Part: TS Resp]
    Line: TS Resp

[Line: TS Resp]
    Field: TS Resp

[Field: TS Resp]
    Use: Name Field
    Set As: $$String:$RESPONSE
    Full Width: Yes

