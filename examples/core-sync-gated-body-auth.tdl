    031: If: NOT ##TSCQuiet
    032: Msg Box: "Pull Stock Groups": ##TSCLogPullStockGroups
    033: End If

[Collection: TSC Pull Col Ledgers]
    Remote URL: @@TSCBase + "/pull/ledgers" + @@TSCAuthQS
    XMLObjectPath: LEDGER: 1: ENVELOPE
    Fetch: NAME, PARENT, GSTIN, STATE, COUNTRY, PINCODE, EMAIL, MOBILE, ADDRESS1, ADDRESS2, OPENINGBALANCE

[Function: TSC Pull Ledgers]
    Variable: vExists: Logical
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Pull blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: Set: TSCCreated: 0
    005: Set: TSCAltered: 0
    006: Set: TSCSkipped: 0
    007: Set: TSCErrors: 0
    008: Walk Collection: TSC Pull Col Ledgers
    009: If: $$IsEmpty:$NAME
    010: Set: TSCSkipped: ##TSCSkipped + 1
    011: Continue
    012: End If
    013: Set: vExists: NOT $$IsEmpty:($Name:Ledger:$NAME)
    014: New Object: Ledger: $NAME: Yes
    015: Set Value: Name: $NAME
    016: If: NOT $$IsEmpty:$PARENT
    017: Set Value: Parent: $PARENT
    018: End If
    019: If: NOT $$IsEmpty:$GSTIN
    020: Set Value: PartyGSTIN: $GSTIN
    021: End If
    022: If: NOT $$IsEmpty:$STATE
    023: Set Value: LedStateName: $STATE
    024: End If
    025: If: NOT $$IsEmpty:$COUNTRY
    026: Set Value: CountryName: $COUNTRY
    027: End If
    028: If: NOT $$IsEmpty:$PINCODE
    029: Set Value: PinCode: $PINCODE
    030: End If
    031: If: NOT $$IsEmpty:$EMAIL
    032: Set Value: Email: $EMAIL
    033: End If
    034: If: NOT $$IsEmpty:$MOBILE
    035: Set Value: LedgerMobile: $MOBILE
    036: End If
    037: If: NOT ##vExists
    038: If: NOT $$IsEmpty:$OPENINGBALANCE
    039: Set Value: OpeningBalance: $$AsAmount:$OPENINGBALANCE
    040: End If
    041: If: NOT $$IsEmpty:$ADDRESS1
    042: Insert Collection Object: Address
    043: Set Value: Address: $ADDRESS1
    044: Set Target: ..
    045: End If
    046: If: NOT $$IsEmpty:$ADDRESS2
    047: Insert Collection Object: Address
    048: Set Value: Address: $ADDRESS2
    049: Set Target: ..
    050: End If
    051: End If
    052: Save Target
    053: If: $$LastResult
    054: If: ##vExists
    055: Set: TSCAltered: ##TSCAltered + 1
    056: Else
    057: Set: TSCCreated: ##TSCCreated + 1
    058: End If
    059: Else
    060: Set: TSCErrors: ##TSCErrors + 1
    061: End If
    062: End Walk
    063: Set: TSCLogPullLedgers: @@TSCStamp + " | created " + $$String:##TSCCreated + ", altered " + $$String:##TSCAltered + ", skipped " + $$String:##TSCSkipped + ", errors " + $$String:##TSCErrors
    064: If: NOT ##TSCQuiet
    065: Msg Box: "Pull Ledgers / Parties": ##TSCLogPullLedgers
    066: End If

[Collection: TSC Pull Col StockItems]
    Remote URL: @@TSCBase + "/pull/stockitems" + @@TSCAuthQS
    XMLObjectPath: STOCKITEM: 1: ENVELOPE
    Fetch: NAME, PARENT, CATEGORY, BASEUNITS, GSTAPPLICABLE, HSNCODE, GSTRATE, OPENINGQTY, OPENINGRATE, OPENINGVALUE

[Function: TSC Pull StockItems]
    Variable: vExists: Logical
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Pull blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: Set: TSCCreated: 0
    005: Set: TSCAltered: 0
    006: Set: TSCSkipped: 0
    007: Set: TSCErrors: 0
    008: Walk Collection: TSC Pull Col StockItems
    009: If: $$IsEmpty:$NAME
    010: Set: TSCSkipped: ##TSCSkipped + 1
    011: Continue
    012: End If
    013: Set: vExists: NOT $$IsEmpty:($Name:Stock Item:$NAME)
    014: New Object: Stock Item: $NAME: Yes
    015: Set Value: Name: $NAME
    016: If: NOT $$IsEmpty:$PARENT
    017: Set Value: Parent: $PARENT
    018: End If
    019: If: NOT $$IsEmpty:$CATEGORY
    020: Set Value: Category: $CATEGORY
    021: End If
    022: If: NOT $$IsEmpty:$BASEUNITS
    023: Set Value: BaseUnits: $BASEUNITS
    024: End If
    025: If: NOT ##vExists
    026: If: NOT $$IsEmpty:$OPENINGQTY
    027: Set Value: OpeningBalance: $$AsQty:$OPENINGQTY
    028: End If
    029: If: NOT $$IsEmpty:$OPENINGRATE
    030: Set Value: OpeningRate: $$AsRate:$OPENINGRATE
    031: End If
    032: If: NOT $$IsEmpty:$OPENINGVALUE
    033: Set Value: OpeningValue: $$AsAmount:$OPENINGVALUE
    034: End If
    035: End If
    036: If: NOT $$IsEmpty:$HSNCODE
    037: Set Value: GSTApplicable: $$SysName:Applicable
    038: Set Value: GSTTypeofSupply: "Goods"
    039: Insert Collection Object: GSTDetails
    040: Set Value: ApplicableFrom: ##SVFromDate
    041: Set Value: HSNCode: $HSNCODE
    042: Set Value: Taxability: "Taxable"
    043: Insert Collection Object: StateWiseDetails
    044: Set Value: StateName: $$SysName:Any
    045: Insert Collection Object: RateDetails
    046: Set Value: GSTRateDutyHead: "Central Tax"
    047: Set Value: GSTRateValuationType: "Based on Value"
    048: Set Value: GSTRate: $$Number:$GSTRATE / 2
    049: Set Target: ..
    050: Insert Collection Object: RateDetails
    051: Set Value: GSTRateDutyHead: "State Tax"
    052: Set Value: GSTRateValuationType: "Based on Value"
    053: Set Value: GSTRate: $$Number:$GSTRATE / 2
    054: Set Target: ..
    055: Insert Collection Object: RateDetails
    056: Set Value: GSTRateDutyHead: "Integrated Tax"
    057: Set Value: GSTRateValuationType: "Based on Value"
    058: Set Value: GSTRate: $$Number:$GSTRATE
    059: Set Target: ..
    060: Set Target: ..
    061: Set Target: ..
    062: End If
    063: Save Target
    064: If: $$LastResult
    065: If: ##vExists
    066: Set: TSCAltered: ##TSCAltered + 1
    067: Else
    068: Set: TSCCreated: ##TSCCreated + 1
    069: End If
    070: Else
    071: Set: TSCErrors: ##TSCErrors + 1
    072: End If
    073: End Walk
    074: Set: TSCLogPullStockItems: @@TSCStamp + " | created " + $$String:##TSCCreated + ", altered " + $$String:##TSCAltered + ", skipped " + $$String:##TSCSkipped + ", errors " + $$String:##TSCErrors
    075: If: NOT ##TSCQuiet
    076: Msg Box: "Pull Stock Items": ##TSCLogPullStockItems
    077: End If

[Collection: TSC Pull Col SalesOrders]
    Remote URL: @@TSCBase + "/pull/salesorders" + @@TSCAuthQS
    XMLObjectPath: VOUCHER: 1: ENVELOPE
    Fetch: VOUCHERNUMBER, DATE, PARTYNAME, REFERENCE, NARRATION, TOTAL

[Collection: TSC Pull Items SalesOrders]
    Remote URL: @@TSCBase + "/pull/salesorders" + @@TSCAuthQS
    XMLObjectPath: ITEM: 1: ENVELOPE
    Fetch: VOUCHERNUMBER, STOCKITEM, QTY, RATE, AMOUNT, GODOWN, BATCH, DUEDATE, LEDGER
    Filter: TSC Flt PullNo

[Collection: TSC Pull Tax SalesOrders]
    Remote URL: @@TSCBase + "/pull/salesorders" + @@TSCAuthQS
    XMLObjectPath: TAX: 1: ENVELOPE
    Fetch: VOUCHERNUMBER, LEDGERNAME, AMOUNT
    Filter: TSC Flt PullNo

[Collection: TSC Exists SalesOrders]
    Type: Voucher
    Fetch: VoucherNumber, VoucherTypeName
    Filter: TSC Flt Exists SalesOrders

[System: Formula]
    TSC Flt Exists SalesOrders: $VoucherNumber = ##TSCPullNo AND $VoucherTypeName = "Sales Order"

[Function: TSC Pull SalesOrders]
    Variable: vExists: Logical
    Local Formula: TSCQty: $$AsQty:$QTY
    Local Formula: TSCRate: $$AsRate:$RATE
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Pull blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: Set: TSCCreated: 0
    005: Set: TSCAltered: 0
    006: Set: TSCSkipped: 0
    007: Set: TSCErrors: 0
    008: Walk Collection: TSC Pull Col SalesOrders
    009: Set: TSCPullNo: $VOUCHERNUMBER
    010: If: $$IsEmpty:##TSCPullNo OR $$NumItems:TSC Exists SalesOrders > 0  ;; existing order numbers are skipped (no duplicates)
    011: Set: TSCSkipped: ##TSCSkipped + 1
    012: Continue
    013: End If
    014: Set: vExists: No
    015: New Object: Voucher
    016: Set Value: VoucherTypeName: "Sales Order"
    017: Set Value: Date: $$Date:$DATE
    018: Set Value: VoucherNumber: $VOUCHERNUMBER
    019: Set Value: PartyLedgerName: $PARTYNAME
    020: Set Value: Reference: $REFERENCE
    021: Set Value: Narration: $NARRATION
    022: Set Value: PersistedView: $$SysName:InvoiceVoucherView
    023: Set Value: IsInvoice: Yes
    024: Insert Collection Object: LedgerEntries
    025: Set Value: LedgerName: $PARTYNAME
    026: Set Value: IsPartyLedger: Yes
    027: Set Value: IsDeemedPositive: Yes
    028: Set Value: Amount: -1 * $$AsAmount:$TOTAL
    029: Set Target: ..
    030: Walk Collection: TSC Pull Items SalesOrders
    031: Insert Collection Object: AllInventoryEntries
    032: Set Value: StockItemName: $STOCKITEM
    033: Set Value: IsDeemedPositive: No
    034: Set Value: Rate: $$TgtObject:@TSCRate
    035: Set Value: BilledQty: $$TgtObject:@TSCQty
    036: Set Value: ActualQty: $$TgtObject:@TSCQty
    037: Set Value: Amount: $$AsAmount:$AMOUNT
    038: Insert Collection Object: BatchAllocations
    039: Set Value: GodownName: if $$IsEmpty:$GODOWN then $$SysName:MainLocation else $GODOWN
    040: Set Value: BatchName: if $$IsEmpty:$BATCH then $$SysName:PrimaryBatch else $BATCH
    041: Set Value: OrderNo: $VOUCHERNUMBER
    042: If: NOT $$IsEmpty:$DUEDATE
    043: Set Value: OrderDueDate: $$Date:$DUEDATE
    044: End If
    045: Set Value: BilledQty: $$TgtObject:@TSCQty
    046: Set Value: ActualQty: $$TgtObject:@TSCQty
    047: Set Value: Amount: $$AsAmount:$AMOUNT
    048: Set Target: ..
    049: Insert Collection Object: AccountingAllocations
    050: Set Value: LedgerName: $LEDGER
    051: Set Value: IsDeemedPositive: No
    052: Set Value: Amount: $$AsAmount:$AMOUNT
    053: Set Target: ..
    054: Set Target: ..
    055: End Walk
    056: Walk Collection: TSC Pull Tax SalesOrders
    057: Insert Collection Object: LedgerEntries
    058: Set Value: LedgerName: $LEDGERNAME
    059: Set Value: IsDeemedPositive: No
    060: Set Value: Amount: $$AsAmount:$AMOUNT
    061: Set Target: ..
    062: End Walk
    063: Save Target
    064: If: $$LastResult
    065: If: ##vExists
    066: Set: TSCAltered: ##TSCAltered + 1
    067: Else
    068: Set: TSCCreated: ##TSCCreated + 1
    069: End If
    070: Else
    071: Set: TSCErrors: ##TSCErrors + 1
    072: End If
    073: End Walk
    074: Set: TSCLogPullSalesOrders: @@TSCStamp + " | created " + $$String:##TSCCreated + ", altered " + $$String:##TSCAltered + ", skipped " + $$String:##TSCSkipped + ", errors " + $$String:##TSCErrors
    075: If: NOT ##TSCQuiet
    076: Msg Box: "Pull Sales Orders": ##TSCLogPullSalesOrders
    077: End If

[Collection: TSC Pull Col PurchaseOrders]
    Remote URL: @@TSCBase + "/pull/purchaseorders" + @@TSCAuthQS
    XMLObjectPath: VOUCHER: 1: ENVELOPE
    Fetch: VOUCHERNUMBER, DATE, PARTYNAME, REFERENCE, NARRATION, TOTAL

[Collection: TSC Pull Items PurchaseOrders]
    Remote URL: @@TSCBase + "/pull/purchaseorders" + @@TSCAuthQS
    XMLObjectPath: ITEM: 1: ENVELOPE
    Fetch: VOUCHERNUMBER, STOCKITEM, QTY, RATE, AMOUNT, GODOWN, BATCH, DUEDATE, LEDGER
    Filter: TSC Flt PullNo

[Collection: TSC Pull Tax PurchaseOrders]
    Remote URL: @@TSCBase + "/pull/purchaseorders" + @@TSCAuthQS
    XMLObjectPath: TAX: 1: ENVELOPE
    Fetch: VOUCHERNUMBER, LEDGERNAME, AMOUNT
    Filter: TSC Flt PullNo

[Collection: TSC Exists PurchaseOrders]
    Type: Voucher
    Fetch: VoucherNumber, VoucherTypeName
    Filter: TSC Flt Exists PurchaseOrders

[System: Formula]
    TSC Flt Exists PurchaseOrders: $VoucherNumber = ##TSCPullNo AND $VoucherTypeName = "Purchase Order"

[Function: TSC Pull PurchaseOrders]
    Variable: vExists: Logical
    Local Formula: TSCQty: $$AsQty:$QTY
    Local Formula: TSCRate: $$AsRate:$RATE
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Pull blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: Set: TSCCreated: 0
    005: Set: TSCAltered: 0
    006: Set: TSCSkipped: 0
    007: Set: TSCErrors: 0
    008: Walk Collection: TSC Pull Col PurchaseOrders
    009: Set: TSCPullNo: $VOUCHERNUMBER
    010: If: $$IsEmpty:##TSCPullNo OR $$NumItems:TSC Exists PurchaseOrders > 0  ;; existing order numbers are skipped (no duplicates)
    011: Set: TSCSkipped: ##TSCSkipped + 1
    012: Continue
    013: End If
    014: Set: vExists: No
    015: New Object: Voucher
    016: Set Value: VoucherTypeName: "Purchase Order"
    017: Set Value: Date: $$Date:$DATE
    018: Set Value: VoucherNumber: $VOUCHERNUMBER
    019: Set Value: PartyLedgerName: $PARTYNAME
    020: Set Value: Reference: $REFERENCE
    021: Set Value: Narration: $NARRATION
    022: Set Value: PersistedView: $$SysName:InvoiceVoucherView
    023: Set Value: IsInvoice: Yes
    024: Insert Collection Object: LedgerEntries
    025: Set Value: LedgerName: $PARTYNAME
    026: Set Value: IsPartyLedger: Yes
    027: Set Value: IsDeemedPositive: No
    028: Set Value: Amount: $$AsAmount:$TOTAL
    029: Set Target: ..
    030: Walk Collection: TSC Pull Items PurchaseOrders
    031: Insert Collection Object: AllInventoryEntries
    032: Set Value: StockItemName: $STOCKITEM
    033: Set Value: IsDeemedPositive: Yes
    034: Set Value: Rate: $$TgtObject:@TSCRate
    035: Set Value: BilledQty: $$TgtObject:@TSCQty
    036: Set Value: ActualQty: $$TgtObject:@TSCQty
    037: Set Value: Amount: -1 * $$AsAmount:$AMOUNT
    038: Insert Collection Object: BatchAllocations
    039: Set Value: GodownName: if $$IsEmpty:$GODOWN then $$SysName:MainLocation else $GODOWN
    040: Set Value: BatchName: if $$IsEmpty:$BATCH then $$SysName:PrimaryBatch else $BATCH
    041: Set Value: OrderNo: $VOUCHERNUMBER
    042: If: NOT $$IsEmpty:$DUEDATE
    043: Set Value: OrderDueDate: $$Date:$DUEDATE
    044: End If
    045: Set Value: BilledQty: $$TgtObject:@TSCQty
    046: Set Value: ActualQty: $$TgtObject:@TSCQty
    047: Set Value: Amount: -1 * $$AsAmount:$AMOUNT
    048: Set Target: ..
    049: Insert Collection Object: AccountingAllocations
    050: Set Value: LedgerName: $LEDGER
    051: Set Value: IsDeemedPositive: Yes
    052: Set Value: Amount: -1 * $$AsAmount:$AMOUNT
    053: Set Target: ..
    054: Set Target: ..
    055: End Walk
    056: Walk Collection: TSC Pull Tax PurchaseOrders
    057: Insert Collection Object: LedgerEntries
    058: Set Value: LedgerName: $LEDGERNAME
    059: Set Value: IsDeemedPositive: Yes
    060: Set Value: Amount: -1 * $$AsAmount:$AMOUNT
    061: Set Target: ..
    062: End Walk
    063: Save Target
    064: If: $$LastResult
    065: If: ##vExists
    066: Set: TSCAltered: ##TSCAltered + 1
    067: Else
    068: Set: TSCCreated: ##TSCCreated + 1
    069: End If
    070: Else
    071: Set: TSCErrors: ##TSCErrors + 1
    072: End If
    073: End Walk
    074: Set: TSCLogPullPurchaseOrders: @@TSCStamp + " | created " + $$String:##TSCCreated + ", altered " + $$String:##TSCAltered + ", skipped " + $$String:##TSCSkipped + ", errors " + $$String:##TSCErrors
    075: If: NOT ##TSCQuiet
    076: Msg Box: "Pull Purchase Orders": ##TSCLogPullPurchaseOrders
    077: End If

[System: Formula]
    TSC Flt PullNo: $VOUCHERNUMBER = ##TSCPullNo

[Function: TSC Pull All]
    000: Set: TSCQuiet: Yes
    001: Call: TSC Pull Groups
    002: Call: TSC Pull Units
    003: Call: TSC Pull Godowns
    004: Call: TSC Pull StockGroups
    005: Call: TSC Pull Ledgers
    006: Call: TSC Pull StockItems
    007: Call: TSC Pull SalesOrders
    008: Call: TSC Pull PurchaseOrders
    009: Set: TSCQuiet: No
    010: Display: TSC Log

[Report: TSC Log]
    Form: TSC Log
    Title: "Sync Log"

[Form: TSC Log]
    Part: TSC Log
    Width: 90% Screen

[Part: TSC Log]
    Lines: TSC Log TSCLogPushGroups, TSC Log TSCLogPushUnits, TSC Log TSCLogPushGodowns, TSC Log TSCLogPushStockGroups, TSC Log TSCLogPushLedgers, TSC Log TSCLogPushStockItems, TSC Log TSCLogPushClosingStock, TSC Log TSCLogPushSalesOrders, TSC Log TSCLogPushPurchaseOrders, TSC Log TSCLogPullGroups, TSC Log TSCLogPullUnits, TSC Log TSCLogPullGodowns, TSC Log TSCLogPullStockGroups, TSC Log TSCLogPullLedgers, TSC Log TSCLogPullStockItems, TSC Log TSCLogPullSalesOrders, TSC Log TSCLogPullPurchaseOrders

