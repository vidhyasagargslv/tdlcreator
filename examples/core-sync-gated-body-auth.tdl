    Variable: vStatus: Number
    000: Set: vStatus: 0
    001: Walk Collection: Parameter Collection
    002: Set: vStatus: $Status
    003: End Walk
    004: If: ##vStatus = 1
    005: Set: TSCLogPushUnits: @@TSCStamp + " | OK"
    006: If: NOT ##TSCQuiet
    007: Msg Box: "Push Units": "Success"
