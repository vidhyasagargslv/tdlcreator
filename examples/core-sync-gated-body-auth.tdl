    031: If: NOT ##TSCQuiet
    032: Msg Box: "Pull Godowns": ##TSCLogPullGodowns
    033: End If

[Collection: TSC Pull Col StockGroups]
    Remote URL: @@TSCBase + "/pull/stockgroups" + @@TSCAuthQS
    XMLObjectPath: STOCKGROUP: 1: ENVELOPE
    Fetch: NAME, PARENT

