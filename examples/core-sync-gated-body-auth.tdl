[Line: TSC Req Units Row]
    XMLTag: "UNIT"
    Fields: TSC Units NAME, TSC Units FORMALNAME, TSC Units DECIMALPLACES, TSC Units ISSIMPLEUNIT, TSC Units GUID, TSC Units MASTERID, TSC Units ALTERID

[Function: TSC Push Units]
