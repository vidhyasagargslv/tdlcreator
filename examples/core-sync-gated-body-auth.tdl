;; ===== TDL Maker v0.3 - CORE SYNC - generated 2026-10-27 =====
;; Push: Groups, Units, Godowns, StockGroups, Ledgers, StockItems, ClosingStock, SalesOrders, PurchaseOrders
;; Pull: Groups, Units, Godowns, StockGroups, Ledgers, StockItems, SalesOrders, PurchaseOrders
;; Incremental push (AlterID high-water mark, advanced only on STATUS=1): No | Auth: body | Gate: name
;; Base URL: http://192.168.1.10:8787
;; Backend contract: see README.md / TESTING.md. Success reply = <ENVELOPE><STATUS>1</STATUS></ENVELOPE>
;; Load via F1 > TDL & Add-On > Manage Local TDLs.  NOT YET VERIFIED ON A REAL TALLYPRIME - follow TESTING.md.

[#Menu: Gateway of Tally]
    Add: Key Item: At End: Sync: Y: Menu: TSC Main

[Menu: TSC Main]
    Title: "Sync"
    Key Item: Configuration: C: Display: TSC Config
    Key Item: Date Range: D: Display: TSC Dates
    Key Item: Push to server: U: Menu: TSC Push Menu
    Key Item: Pull from server: L: Menu: TSC Pull Menu
    Key Item: Sync Log: Y: Display: TSC Log
    Item: Blank
    Key Item: @@locQuit: Q: Menu Quit

[Menu: TSC Push Menu]
    Title: "Push to server"
    Key Item: Push Groups: 1: Call: TSC Push Groups
    Key Item: Push Units: 2: Call: TSC Push Units
    Key Item: Push Godowns: 3: Call: TSC Push Godowns
    Key Item: Push Stock Groups: 4: Call: TSC Push StockGroups
    Key Item: Push Ledgers / Parties: 5: Call: TSC Push Ledgers
    Key Item: Push Stock Items: 6: Call: TSC Push StockItems
    Key Item: Push Closing Stock: 7: Call: TSC Push ClosingStock
    Key Item: Push Sales Orders: 8: Call: TSC Push SalesOrders
    Key Item: Push Purchase Orders: 9: Call: TSC Push PurchaseOrders
    Key Item: Push ALL (dependency order): P: Call: TSC Push All

[Menu: TSC Pull Menu]
    Title: "Pull from server"
    Key Item: Pull Groups: 1: Call: TSC Pull Groups
    Key Item: Pull Units: 2: Call: TSC Pull Units
    Key Item: Pull Godowns: 3: Call: TSC Pull Godowns
    Key Item: Pull Stock Groups: 4: Call: TSC Pull StockGroups
    Key Item: Pull Ledgers / Parties: 5: Call: TSC Pull Ledgers
    Key Item: Pull Stock Items: 6: Call: TSC Pull StockItems
    Key Item: Pull Sales Orders: 7: Call: TSC Pull SalesOrders
    Key Item: Pull Purchase Orders: 8: Call: TSC Pull PurchaseOrders
    Key Item: Pull ALL (dependency order): P: Call: TSC Pull All

[Variable: TSApiURL]
    Type: String
    Persistent: Yes

[Variable: TSApiKey]
    Type: String
    Persistent: Yes

[Variable: TSCompanyCode]
    Type: String
    Persistent: Yes

[Variable: TSGateCompany]
    Type: String
    Persistent: Yes

[Variable: TSGateGSTIN]
    Type: String
    Persistent: Yes

[Variable: TSBasicAuth]
    Type: String
    Persistent: Yes

[Variable: TSFromDate]
    Type: Date
    Persistent: Yes

[Variable: TSToDate]
    Type: Date
    Persistent: Yes

[Variable: TSCAltGroups]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushGroups]
    Type: String
    Persistent: Yes

[Variable: TSCAltUnits]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushUnits]
    Type: String
    Persistent: Yes

[Variable: TSCAltGodowns]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushGodowns]
    Type: String
    Persistent: Yes

[Variable: TSCAltStockGroups]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushStockGroups]
    Type: String
    Persistent: Yes

[Variable: TSCAltLedgers]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushLedgers]
    Type: String
    Persistent: Yes

[Variable: TSCAltStockItems]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushStockItems]
    Type: String
    Persistent: Yes

[Variable: TSCAltClosingStock]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushClosingStock]
    Type: String
    Persistent: Yes

[Variable: TSCAltSalesOrders]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushSalesOrders]
    Type: String
    Persistent: Yes

[Variable: TSCAltPurchaseOrders]
    Type: Number
    Persistent: Yes

[Variable: TSCLogPushPurchaseOrders]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullGroups]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullUnits]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullGodowns]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullStockGroups]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullLedgers]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullStockItems]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullSalesOrders]
    Type: String
    Persistent: Yes

[Variable: TSCLogPullPurchaseOrders]
    Type: String
    Persistent: Yes

[Variable: TSCMaxAlt]
    Type: Number
    Persistent: No

[Variable: TSCQuiet]
    Type: Logical
    Persistent: No

[Variable: TSCPullNo]
    Type: String
    Persistent: No

[Variable: TSCCreated]
    Type: Number
    Persistent: No

[Variable: TSCAltered]
    Type: Number
    Persistent: No

[Variable: TSCSkipped]
    Type: Number
    Persistent: No

[Variable: TSCErrors]
    Type: Number
    Persistent: No

[System: Variable]
    TSApiURL: "http://192.168.1.10:8787"
    TSApiKey: "YOUR_API_KEY"
    TSCompanyCode: "ACME"
    TSGateCompany: "ACME Pvt Ltd"
    TSGateGSTIN: ""
    TSBasicAuth: ""
    TSFromDate: $$MonthStart:##SVCurrentDate
    TSToDate: $$MonthEnd:##SVCurrentDate
    TSCAltGroups: 0
    TSCLogPushGroups: "never"
    TSCAltUnits: 0
    TSCLogPushUnits: "never"
    TSCAltGodowns: 0
    TSCLogPushGodowns: "never"
    TSCAltStockGroups: 0
    TSCLogPushStockGroups: "never"
    TSCAltLedgers: 0
    TSCLogPushLedgers: "never"
    TSCAltStockItems: 0
    TSCLogPushStockItems: "never"
    TSCAltClosingStock: 0
    TSCLogPushClosingStock: "never"
    TSCAltSalesOrders: 0
    TSCLogPushSalesOrders: "never"
    TSCAltPurchaseOrders: 0
    TSCLogPushPurchaseOrders: "never"
    TSCLogPullGroups: "never"
    TSCLogPullUnits: "never"
    TSCLogPullGodowns: "never"
    TSCLogPullStockGroups: "never"
    TSCLogPullLedgers: "never"
    TSCLogPullStockItems: "never"
    TSCLogPullSalesOrders: "never"
    TSCLogPullPurchaseOrders: "never"
    TSCMaxAlt: 0
    TSCQuiet: No
    TSCPullNo: ""
    TSCCreated: 0
    TSCAltered: 0
    TSCSkipped: 0
    TSCErrors: 0

[System: Formula]
    TSCBase: ##TSApiURL  ;; editable in Configuration screen
    TSCAuthQS: ""
    TSCGateOK: $$IsEqual:##SVCurrentCompany:##TSGateCompany
    TSCStamp: $$String:$$MachineDate + " " + $$String:$$MachineTime

[Report: TSC Config]
    Form: TSC Config
    Title: "Sync Configuration"
    Variable: TSApiURL
    Variable: TSApiKey
    Variable: TSCompanyCode
    Variable: TSGateCompany
    Variable: TSGateGSTIN

[Form: TSC Config]
    Part: TSC Config
    Width: 70% Screen

[Part: TSC Config]
    Lines: TSC Config TSApiURL, TSC Config TSApiKey, TSC Config TSCompanyCode, TSC Config TSGateCompany, TSC Config TSGateGSTIN

[Line: TSC Config TSApiURL]
    Fields: Medium Prompt, TSC Config TSApiURL Fld
    Local: Field: Medium Prompt: Info: "Base URL"

[Field: TSC Config TSApiURL Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiURL
    Modifies: TSApiURL: Yes

[Line: TSC Config TSApiKey]
    Fields: Medium Prompt, TSC Config TSApiKey Fld
    Local: Field: Medium Prompt: Info: "API Key"

[Field: TSC Config TSApiKey Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSApiKey
    Modifies: TSApiKey: Yes

[Line: TSC Config TSCompanyCode]
    Fields: Medium Prompt, TSC Config TSCompanyCode Fld
    Local: Field: Medium Prompt: Info: "Company Code"

[Field: TSC Config TSCompanyCode Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSCompanyCode
    Modifies: TSCompanyCode: Yes

[Line: TSC Config TSGateCompany]
    Fields: Medium Prompt, TSC Config TSGateCompany Fld
    Local: Field: Medium Prompt: Info: "Allowed Company"

[Field: TSC Config TSGateCompany Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSGateCompany
    Modifies: TSGateCompany: Yes

[Line: TSC Config TSGateGSTIN]
    Fields: Medium Prompt, TSC Config TSGateGSTIN Fld
    Local: Field: Medium Prompt: Info: "Allowed GSTIN"

[Field: TSC Config TSGateGSTIN Fld]
    Use: Name Field
    Max: 250
    Set As: ##TSGateGSTIN
    Modifies: TSGateGSTIN: Yes

[Report: TSC Dates]
    Form: TSC Dates
    Title: "Sync Date Range"
    Variable: TSFromDate
    Variable: TSToDate

[Form: TSC Dates]
    Part: TSC Dates
    Width: 70% Screen

[Part: TSC Dates]
    Lines: TSC Dates TSFromDate, TSC Dates TSToDate

[Line: TSC Dates TSFromDate]
    Fields: Medium Prompt, TSC Dates TSFromDate Fld
    Local: Field: Medium Prompt: Info: "From"

[Field: TSC Dates TSFromDate Fld]
    Use: Uni Date Field
    Set As: ##TSFromDate
    Modifies: TSFromDate: Yes

[Line: TSC Dates TSToDate]
    Fields: Medium Prompt, TSC Dates TSToDate Fld
    Local: Field: Medium Prompt: Info: "To"

[Field: TSC Dates TSToDate Fld]
    Use: Uni Date Field
    Set As: ##TSToDate
    Modifies: TSToDate: Yes

[Collection: TSC Col Groups]
    Type: Group
    Fetch: *.*

[System: Formula]

[Report: TSC Req Groups]
    Form: TSC Req Groups
    Export: Yes
    Export Header: "Content-Type: application/xml"

[Form: TSC Req Groups]
    Part: TSC Req Groups Hdr, TSC Req Groups Body
    XMLTag: "ENVELOPE"

[Part: TSC Req Groups Hdr]
    Line: TSC Req Groups Hdr

[Line: TSC Req Groups Hdr]
    XMLTag: "HEADER"
    Fields: TSC H ENTITY, TSC H COMPANY, TSC H COMPANYNAME, TSC H FROMDATE, TSC H TODATE, TSC H COUNT, TSC H APIKEY

[Part: TSC Req Groups Body]
    Line: TSC Req Groups Row
    Repeat: TSC Req Groups Row: TSC Col Groups
    Scroll: Vertical

[Line: TSC Req Groups Row]
    XMLTag: "GROUP"
    Fields: TSC Groups NAME, TSC Groups PARENT, TSC Groups ISREVENUE, TSC Groups GUID, TSC Groups MASTERID, TSC Groups ALTERID

[Function: TSC Push Groups]
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Push blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: HTTP Request: @@TSCBase + "/push/groups" + @@TSCAuthQS: POST: XML: ASCII: TSC Req Groups: TSC After Groups

[Function: TSC After Groups]
    Variable: vStatus: Number
    000: Set: vStatus: 0
    001: Walk Collection: Parameter Collection
    002: Set: vStatus: $Status
    003: End Walk
    004: If: ##vStatus = 1
    005: Set: TSCLogPushGroups: @@TSCStamp + " | OK"
    006: If: NOT ##TSCQuiet
    007: Msg Box: "Push Groups": "Success"
    008: End If
    009: Else
    010: Set: TSCLogPushGroups: @@TSCStamp + " | FAILED (STATUS not 1)"
    011: If: NOT ##TSCQuiet
    012: Msg Box: "Push Groups": "Failed - nothing marked as synced"
    013: End If
    014: End If

[Collection: TSC Col Units]
    Type: Unit
    Fetch: *.*

[System: Formula]

[Report: TSC Req Units]
    Form: TSC Req Units
    Export: Yes
    Export Header: "Content-Type: application/xml"

[Form: TSC Req Units]
