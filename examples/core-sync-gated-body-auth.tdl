[Collection: TSC Col SalesOrders]
    Type: Voucher
    Fetch: *.*
    Filter: TSC Flt SalesOrders, TSC Flt Date

[System: Formula]
    TSC Flt SalesOrders: $VoucherTypeName = "Sales Order" OR $$IsSysNameEqual:SalesOrder:($Parent:VoucherType:$VoucherTypeName)  ;; covers custom types under Sales Order

[Report: TSC Req SalesOrders]
    Form: TSC Req SalesOrders
    Export: Yes
    Export Header: "Content-Type: application/xml"

[Form: TSC Req SalesOrders]
    Part: TSC Req SalesOrders Hdr, TSC Req SalesOrders Body
    XMLTag: "ENVELOPE"

[Part: TSC Req SalesOrders Hdr]
    Line: TSC Req SalesOrders Hdr

[Line: TSC Req SalesOrders Hdr]
    XMLTag: "HEADER"
    Fields: TSC H ENTITY, TSC H COMPANY, TSC H COMPANYNAME, TSC H FROMDATE, TSC H TODATE, TSC H COUNT, TSC H APIKEY

[Part: TSC Req SalesOrders Body]
    Line: TSC Req SalesOrders Row
    Repeat: TSC Req SalesOrders Row: TSC Col SalesOrders
    Scroll: Vertical

[Line: TSC Req SalesOrders Row]
    XMLTag: "VOUCHER"
    Fields: TSC V DATE, TSC V VOUCHERTYPE, TSC V VOUCHERNUMBER, TSC V REFERENCE, TSC V PARTYNAME, TSC V PARTYGSTIN, TSC V PLACEOFSUPPLY, TSC V NARRATION, TSC V TOTAL, TSC V GUID, TSC V MASTERID, TSC V ALTERID
    Explode: TSC Inv Part: Yes
    Explode: TSC Led Part: Yes

[Function: TSC Push SalesOrders]
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Push blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: HTTP Request: @@TSCBase + "/push/salesorders" + @@TSCAuthQS: POST: XML: ASCII: TSC Req SalesOrders: TSC After SalesOrders

[Function: TSC After SalesOrders]
    Variable: vStatus: Number
    000: Set: vStatus: 0
    001: Walk Collection: Parameter Collection
    002: Set: vStatus: $Status
    003: End Walk
    004: If: ##vStatus = 1
    005: Set: TSCLogPushSalesOrders: @@TSCStamp + " | OK"
    006: If: NOT ##TSCQuiet
    007: Msg Box: "Push Sales Orders": "Success"
    008: End If
    009: Else
    010: Set: TSCLogPushSalesOrders: @@TSCStamp + " | FAILED (STATUS not 1)"
    011: If: NOT ##TSCQuiet
    012: Msg Box: "Push Sales Orders": "Failed - nothing marked as synced"
    013: End If
    014: End If

[Collection: TSC Col PurchaseOrders]
    Type: Voucher
    Fetch: *.*
    Filter: TSC Flt PurchaseOrders, TSC Flt Date

[System: Formula]
    TSC Flt PurchaseOrders: $VoucherTypeName = "Purchase Order" OR $$IsSysNameEqual:PurchaseOrder:($Parent:VoucherType:$VoucherTypeName)  ;; covers custom types under Purchase Order

[Report: TSC Req PurchaseOrders]
    Form: TSC Req PurchaseOrders
    Export: Yes
    Export Header: "Content-Type: application/xml"

[Form: TSC Req PurchaseOrders]
    Part: TSC Req PurchaseOrders Hdr, TSC Req PurchaseOrders Body
    XMLTag: "ENVELOPE"

[Part: TSC Req PurchaseOrders Hdr]
    Line: TSC Req PurchaseOrders Hdr

[Line: TSC Req PurchaseOrders Hdr]
    XMLTag: "HEADER"
    Fields: TSC H ENTITY, TSC H COMPANY, TSC H COMPANYNAME, TSC H FROMDATE, TSC H TODATE, TSC H COUNT, TSC H APIKEY

[Part: TSC Req PurchaseOrders Body]
    Line: TSC Req PurchaseOrders Row
    Repeat: TSC Req PurchaseOrders Row: TSC Col PurchaseOrders
    Scroll: Vertical

[Line: TSC Req PurchaseOrders Row]
    XMLTag: "VOUCHER"
    Fields: TSC V DATE, TSC V VOUCHERTYPE, TSC V VOUCHERNUMBER, TSC V REFERENCE, TSC V PARTYNAME, TSC V PARTYGSTIN, TSC V PLACEOFSUPPLY, TSC V NARRATION, TSC V TOTAL, TSC V GUID, TSC V MASTERID, TSC V ALTERID
    Explode: TSC Inv Part: Yes
    Explode: TSC Led Part: Yes

[Function: TSC Push PurchaseOrders]
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Push blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: HTTP Request: @@TSCBase + "/push/purchaseorders" + @@TSCAuthQS: POST: XML: ASCII: TSC Req PurchaseOrders: TSC After PurchaseOrders

[Function: TSC After PurchaseOrders]
    Variable: vStatus: Number
    000: Set: vStatus: 0
    001: Walk Collection: Parameter Collection
    002: Set: vStatus: $Status
    003: End Walk
    004: If: ##vStatus = 1
    005: Set: TSCLogPushPurchaseOrders: @@TSCStamp + " | OK"
    006: If: NOT ##TSCQuiet
    007: Msg Box: "Push Purchase Orders": "Success"
    008: End If
    009: Else
    010: Set: TSCLogPushPurchaseOrders: @@TSCStamp + " | FAILED (STATUS not 1)"
    011: If: NOT ##TSCQuiet
    012: Msg Box: "Push Purchase Orders": "Failed - nothing marked as synced"
    013: End If
    014: End If

[Part: TSC Inv Part]
    Line: TSC Inv Line
    Repeat: TSC Inv Line: AllInventoryEntries
    Scroll: Vertical

[Line: TSC Inv Line]
    XMLTag: "INVENTORYENTRY"
    Fields: TSC I STOCKITEM, TSC I QTY, TSC I ACTUALQTY, TSC I RATE, TSC I DISCOUNT, TSC I AMOUNT, TSC I GSTRATE
    Explode: TSC Bat Part: Yes
    Explode: TSC Acc Part: Yes

[Part: TSC Bat Part]
    Line: TSC Bat Line
    Repeat: TSC Bat Line: BatchAllocations
    Scroll: Vertical

[Line: TSC Bat Line]
    XMLTag: "BATCH"
    Fields: TSC B GODOWN, TSC B BATCH, TSC B ORDERNO, TSC B DUEDATE, TSC B QTY, TSC B AMOUNT

[Part: TSC Acc Part]
    Line: TSC Acc Line
    Repeat: TSC Acc Line: AccountingAllocations
    Scroll: Vertical

[Line: TSC Acc Line]
    XMLTag: "ACCOUNTINGALLOCATION"
    Fields: TSC A LEDGERNAME, TSC A AMOUNT

[Part: TSC Led Part]
    Line: TSC Led Line
    Repeat: TSC Led Line: LedgerEntries
    Scroll: Vertical

[Line: TSC Led Line]
    XMLTag: "LEDGERENTRY"
    Fields: TSC L LEDGERNAME, TSC L AMOUNT, TSC L ISPARTY

[System: Formula]
    TSC Flt Date: $Date >= ##TSFromDate AND $Date <= ##TSToDate

[Function: TSC Push All]
    000: Set: TSCQuiet: Yes
    001: Call: TSC Push Groups
    002: Call: TSC Push Units
    003: Call: TSC Push Godowns
    004: Call: TSC Push StockGroups
    005: Call: TSC Push Ledgers
    006: Call: TSC Push StockItems
    007: Call: TSC Push ClosingStock
    008: Call: TSC Push SalesOrders
    009: Call: TSC Push PurchaseOrders
    010: Set: TSCQuiet: No
    011: Display: TSC Log

[Collection: TSC Pull Col Groups]
    Remote URL: @@TSCBase + "/pull/groups" + @@TSCAuthQS
    XMLObjectPath: GROUP: 1: ENVELOPE
    Fetch: NAME, PARENT

[Function: TSC Pull Groups]
    Variable: vExists: Logical
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Pull blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: Set: TSCCreated: 0
    005: Set: TSCAltered: 0
    006: Set: TSCSkipped: 0
    007: Set: TSCErrors: 0
    008: Walk Collection: TSC Pull Col Groups
    009: If: $$IsEmpty:$NAME
    010: Set: TSCSkipped: ##TSCSkipped + 1
    011: Continue
    012: End If
    013: Set: vExists: NOT $$IsEmpty:($Name:Group:$NAME)
    014: New Object: Group: $NAME: Yes
    015: Set Value: Name: $NAME
    016: If: NOT $$IsEmpty:$PARENT
    017: Set Value: Parent: $PARENT
    018: End If
    019: Save Target
    020: If: $$LastResult
    021: If: ##vExists
    022: Set: TSCAltered: ##TSCAltered + 1
    023: Else
    024: Set: TSCCreated: ##TSCCreated + 1
    025: End If
    026: Else
    027: Set: TSCErrors: ##TSCErrors + 1
    028: End If
    029: End Walk
    030: Set: TSCLogPullGroups: @@TSCStamp + " | created " + $$String:##TSCCreated + ", altered " + $$String:##TSCAltered + ", skipped " + $$String:##TSCSkipped + ", errors " + $$String:##TSCErrors
    031: If: NOT ##TSCQuiet
    032: Msg Box: "Pull Groups": ##TSCLogPullGroups
    033: End If

[Collection: TSC Pull Col Units]
    Remote URL: @@TSCBase + "/pull/units" + @@TSCAuthQS
    XMLObjectPath: UNIT: 1: ENVELOPE
    Fetch: NAME, FORMALNAME, DECIMALPLACES

[Function: TSC Pull Units]
    Variable: vExists: Logical
    000: If: NOT @@TSCGateOK
    001: Msg Box: "Pull blocked": "Open company does not match the configured company"
    002: Return
    003: End If
    004: Set: TSCCreated: 0
    005: Set: TSCAltered: 0
    006: Set: TSCSkipped: 0
    007: Set: TSCErrors: 0
    008: Walk Collection: TSC Pull Col Units
    009: If: $$IsEmpty:$NAME
    010: Set: TSCSkipped: ##TSCSkipped + 1
    011: Continue
    012: End If
    013: Set: vExists: NOT $$IsEmpty:($Name:Unit:$NAME)
    014: New Object: Unit: $NAME: Yes
    015: Set Value: Name: $NAME
    016: If: NOT $$IsEmpty:$FORMALNAME
    017: Set Value: OriginalName: $FORMALNAME
    018: End If
    019: If: NOT $$IsEmpty:$DECIMALPLACES
    020: Set Value: DecimalPlaces: $$Number:$DECIMALPLACES
    021: End If
    022: If: NOT ##vExists
    023: If: NOT $$IsEmpty:Yes
    024: Set Value: IsSimpleUnit: Yes
    025: End If
    026: End If
    027: Save Target
    028: If: $$LastResult
    029: If: ##vExists
    030: Set: TSCAltered: ##TSCAltered + 1
    031: Else
    032: Set: TSCCreated: ##TSCCreated + 1
    033: End If
    034: Else
    035: Set: TSCErrors: ##TSCErrors + 1
    036: End If
    037: End Walk
    038: Set: TSCLogPullUnits: @@TSCStamp + " | created " + $$String:##TSCCreated + ", altered " + $$String:##TSCAltered + ", skipped " + $$String:##TSCSkipped + ", errors " + $$String:##TSCErrors
    039: If: NOT ##TSCQuiet
    040: Msg Box: "Pull Units": ##TSCLogPullUnits
    041: End If

[Collection: TSC Pull Col Godowns]
    Remote URL: @@TSCBase + "/pull/godowns" + @@TSCAuthQS
    XMLObjectPath: GODOWN: 1: ENVELOPE
